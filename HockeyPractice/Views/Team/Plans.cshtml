@model PlanListViewModel
@{
    var sub = Context.Request.Query["sub"].ToString();
    ViewBag.Title = Model.Ctx.Team.Name + " – Practice Plans";
    ViewBag.Team = Model.Ctx.Team;
}
@await Html.PartialAsync("_TeamHeader", Model.Ctx)

<div class="hp-shell">
    @if (!string.IsNullOrWhiteSpace(Model.Ctx.Team.SafeSpotifyPlaylistUrl))
    {
        <a class="hp-card hp-card-spotify" style="margin-top:1.25rem;"
           href="@Model.Ctx.Team.SafeSpotifyPlaylistUrl" target="_blank" rel="noopener noreferrer">
            <div class="hp-card-when hp-card-spotify-label">&#9834; Team playlist</div>
            <div class="hp-card-title">Open in Spotify</div>
            <div class="hp-card-meta"><span>Add your songs before practice</span></div>
        </a>
    }

    @if (Model.Ctx.IsManager)
    {
        <a class="hp-btn hp-btn-accent hp-btn-block" style="margin-top:1.25rem;"
           asp-controller="Coach" asp-action="NewPlan" asp-route-slug="@Model.Ctx.Team.Slug">
            + New practice plan
        </a>
    }

    @if (!Model.HasAny)
    {
        <h1 class="hp-title">Practice plans</h1>
        <div class="hp-empty">
            Nothing posted yet.<br />
            <span class="hp-muted">Your coach will put the next practice plan here.</span>
        </div>
    }
    else
    {
        @if (Model.Next is not null)
        {
            <div class="hp-section" style="margin-top:1.4rem;">Next practice</div>
            @await Html.PartialAsync("_PlanCard", Model.Next, new ViewDataDictionary(ViewData) { ["Next"] = true })
        }

        @if (Model.Upcoming.Count > 0)
        {
            <div class="hp-section">Coming up</div>
            @foreach (var card in Model.Upcoming)
            {
                @await Html.PartialAsync("_PlanCard", card)
            }
        }

        @if (Model.Past.Count > 0)
        {
            <div class="hp-section">Earlier</div>
            @foreach (var card in Model.Past)
            {
                @await Html.PartialAsync("_PlanCard", card)
            }
        }
    }

    @* Not shown to managers: the person posting the plans has no use for a "tell me when a
       plan is posted" box, and it crowds the page they now land on. A manager previewing the
       player view still sees it, since that's the point of previewing. *@
    @if (!Model.Ctx.IsManager && Model.EmailSignupAvailable)
    {
    <div class="hp-section" id="heads-up">Get a heads-up</div>
    <div class="hp-panel">
        @if (sub == "check")
        {
            <div class="hp-notice">Check your email for a confirmation link.</div>
        }
        else if (sub == "already")
        {
            <div class="hp-notice">That address is already signed up.</div>
        }
        else if (sub == "invalid")
        {
            <div class="hp-error">That doesn't look like an email address.</div>
        }

        <p class="hp-muted" style="margin-top:0;">
            Parents: get an email whenever a new practice plan is posted.
        </p>
        <form method="post" asp-controller="Subscription" asp-action="Subscribe"
              asp-route-slug="@Model.Ctx.Team.Slug" class="hp-row">
            @Html.AntiForgeryToken()
            <input class="hp-input" type="email" name="email" required
                   placeholder="you@example.com" autocomplete="email"
                   style="flex:1;min-width:12rem;" />
            <button type="submit" class="hp-btn">Notify me</button>
        </form>
    </div>
    }
</div>
