@model HomeViewModel
@{ ViewBag.Title = "EBHockey Plans"; }
<div class="hp-rail"></div>
<div class="hp-shell">
    @* Still an h1 so the page keeps its heading; the alt text carries the name for screen
       readers and search. *@
    <h1 class="hp-title hp-home-brand">
        <img src="~/logo-wordmark.png" alt="EBHockey Plans" width="880" height="275" />
    </h1>

    @if (Model.Teams.Count == 0)
    {
        <div class="hp-empty">
            No teams yet.<br />
            <span class="hp-muted">Whoever runs this site sets them up from Site admin, below.</span>
        </div>
    }
    else
    {
        <p class="hp-muted" style="margin-top:0;">Choose your team.</p>

        @foreach (var team in Model.Teams)
        {
            var level = Model.LevelFor(team.Id);
            var logoUrl = team.LogoFileName is null
                ? null
                : Url.Action("Logo", "Team", new { slug = team.Slug });
            var initials = string.Join("", team.Name
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2).Select(w => char.ToUpperInvariant(w[0])));

            @* Each card carries its own team's colours, so everything inside it — the badge,
               the rail, the primary button — picks them up. The page itself can't be themed:
               with more than one team there is no single palette to apply. *@
            <div class="hp-teamcard" style="@HockeyPractice.Infrastructure.Palette.CssVariables(team.SafePrimary, team.SafeAccent)">
                <div class="hp-teamcard-rail"></div>
                <div class="hp-teamcard-head">
                    @if (logoUrl is not null)
                    {
                        <img class="hp-teamcard-logo" src="@logoUrl" alt="" />
                    }
                    else
                    {
                        <div class="hp-topbar-fallback" aria-hidden="true">@initials</div>
                    }
                    <div style="min-width:0;">
                        <div class="hp-teamcard-name">@team.Name</div>
                        @if (level == TeamAccessLevel.Manager)
                        {
                            <div class="hp-topbar-sub">You manage this team</div>
                        }
                        else if (level == TeamAccessLevel.Player)
                        {
                            <div class="hp-topbar-sub">You're signed in</div>
                        }
                    </div>
                </div>

                @* Two ways in, stated plainly. The player path is the primary action because
                   that is what almost everyone visiting this site is here to do. *@
                <div class="hp-teamcard-actions">
                    <a class="hp-btn hp-btn-block" asp-controller="Team" asp-action="Plans"
                       asp-route-slug="@team.Slug">
                        @(level == TeamAccessLevel.None ? "See practice plans" : "Practice plans")
                    </a>

                    @if (level == TeamAccessLevel.Manager)
                    {
                        <a class="hp-btn hp-btn-quiet hp-btn-block" asp-controller="Coach"
                           asp-action="Index" asp-route-slug="@team.Slug">Manage team</a>
                    }
                    else
                    {
                        <a class="hp-teamcard-manage" asp-controller="Team" asp-action="EnterCode"
                           asp-route-slug="@team.Slug" asp-route-manage="true">
                            Coach or team manager? Sign in to manage &rarr;
                        </a>
                    }
                </div>
            </div>
        }
    }

    @* Outside the team loop, so it sits under the cards rather than inside one. *@
    <div class="hp-panel" style="margin-top:1.25rem;">
        <a asp-action="WhatsNew" style="font-weight:600;">What's new on this site &rarr;</a>
        <div class="hp-muted" style="font-size:.85rem;margin-top:.2rem;">
            Recent changes and additions, newest first.
        </div>
    </div>
</div>
