@using HockeyPractice.Services
@model PlanDetailViewModel
@{
    ViewBag.Title = Model.Plan.Title + " – " + Model.Ctx.Team.Name;
    ViewBag.Team = Model.Ctx.Team;

    var fileUrl = Url.Action("File", "Plan", new { slug = Model.Ctx.Team.Slug, id = Model.Plan.Id })!;
    var downloadUrl = Url.Action("File", "Plan",
        new { slug = Model.Ctx.Team.Slug, id = Model.Plan.Id, download = true })!;
    var beaconUrl = Url.Action("Viewed", "Plan", new { slug = Model.Ctx.Team.Slug, id = Model.Plan.Id })!;
    // pdf.js reads the document from ?file=; page-width is the only sane default on a phone.
    var viewerUrl = Url.Content("~/lib/pdfjs/web/viewer.html")
        + "?file=" + Uri.EscapeDataString(fileUrl) + "#zoom=page-width";
}
@await Html.PartialAsync("_TeamHeader", Model.Ctx)

<div class="hp-shell">
    <div class="hp-card-when" style="margin-top:1.3rem;">@Model.WhenLabel</div>
    <h1 class="hp-title" style="margin-top:.15rem;">@Model.Plan.Title</h1>

    <div class="hp-card-meta" style="margin-bottom:.6rem;">
        @if (!string.IsNullOrWhiteSpace(Model.Plan.Location))
        {
            <span>@Model.Plan.Location</span>
        }
        @if (Model.Plan.Status == PlanStatus.Draft)
        {
            <span class="hp-pill hp-pill-draft">Draft</span>
        }
        @if (Model.ViewedByMe && Model.Ctx.Me is not null)
        {
            <span class="hp-pill hp-pill-viewed">✓ You've viewed this</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Plan.CoachNotes))
    {
        <div class="hp-panel" style="border-left:4px solid var(--hp-accent);">
            @Model.Plan.CoachNotes
        </div>
    }

    @if (Model.Videos.Count > 0)
    {
        <div class="hp-section" style="margin-top:1.2rem;">Watch before practice</div>
        <div class="hp-videos">
            @for (var i = 0; i < Model.Videos.Count; i++)
            {
                var link = Model.Videos[i];
                var thumb = LinkExtractionService.ThumbnailUrl(link);
                var embed = LinkExtractionService.EmbedUrl(link);
                var host = Uri.TryCreate(link.Url, UriKind.Absolute, out var u) ? u.Host.Replace("www.", "") : "link";
                @* Embeddable videos play in place. Anything we can't frame keeps the plain
                   new-tab behaviour rather than opening a player that would never load. *@
                <a class="hp-video" href="@link.Url"
                   data-embed="@embed" data-label="@link.Label" data-section="@link.Section" data-vid="@(link.VideoId is null ? "" : (link.Kind == LinkKind.YouTube ? "yt:" : "vm:") + link.VideoId)" data-index="@i"
                   target="_blank" rel="noopener noreferrer">
                    <div class="hp-video-thumb">
                        @if (thumb is not null)
                        {
                            <img src="@thumb" alt="" loading="lazy" />
                        }
                        <span class="hp-video-play"><span>▶</span></span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(link.Section))
                    {
                        <div class="hp-video-section">@link.Section</div>
                    }
                    <div class="hp-video-label">@link.Label</div>
                    <div class="hp-video-host">@host</div>
                </a>
            }
        </div>
    }

    @if (Model.IsDrillPlan)
    {
        <div class="hp-section">The plan</div>

        @if (Model.Drills.Count == 0)
        {
            <div class="hp-empty">
                No drills in this plan yet.<br />
                <span class="hp-muted">Your coach is still putting it together.</span>
            </div>
        }
        else
        {
            var total = RunTimeTotal.From(Model.Drills);
            if (total.HasAnything && !string.IsNullOrEmpty(total.Label))
            {
                <div class="hp-runtime-total">
                    <strong>@Model.Drills.Count drill@(Model.Drills.Count == 1 ? "" : "s")</strong>
                    · @total.Label
                </div>
            }

            <div id="hp-drills">
                @for (var i = 0; i < Model.Drills.Count; i++)
                {
                    var card = Model.Drills[i];
                    var drill = card.Drill;

                    <div class="hp-drill">
                        <div class="hp-drill-head">
                            <span class="hp-drill-num">@(i + 1)</span>
                            <h2 class="hp-drill-title">@drill.Title</h2>
                            @if (drill.RunTimeMinutes is int mins)
                            {
                                <span class="hp-drill-time">@HockeyPractice.Infrastructure.RunTime.Human(mins)</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(drill.Description))
                        {
                            <div class="hp-drill-body">@drill.Description</div>
                        }

                        @foreach (var picture in card.Diagrams)
                        {
                            var pictureUrl = Url.Action("Diagram", "Drill", new
                            {
                                slug = Model.Ctx.Team.Slug, id = drill.Id, diagramId = picture.Id
                            });

                            if (picture.IsPdf)
                            {
                                <a class="hp-btn hp-btn-quiet hp-btn-sm" style="margin-top:.6rem;"
                                   href="@pictureUrl" target="_blank" rel="noopener noreferrer">
                                    Open the diagram (PDF)
                                </a>
                            }
                            else
                            {
                                @* Real alt text, not alt="": a diagram is content, and an empty alt
                                   would leave a screen-reader user with nothing at all here. *@
                                <img class="hp-drill-diagram" src="@pictureUrl" loading="lazy"
                                     alt="Diagram for @drill.Title" />
                            }
                        }

                        @if (card.HasVideo)
                        {
                            @* data-embed is what the popup player picks up. Without it (a link we
                               can't frame) this stays an ordinary link and opens in a new tab. *@
                            <a class="hp-btn hp-btn-quiet hp-btn-sm" style="margin-top:.6rem;"
                               href="@drill.VideoUrl"
                               data-embed="@card.EmbedUrl" data-label="@drill.Title"
                               target="_blank" rel="noopener noreferrer">
                                ▶ Watch the drill
                            </a>
                        }
                    </div>
                }
            </div>
        }

        <div class="hp-row" style="margin-top:.8rem;">
            <button type="button" class="hp-btn hp-btn-quiet" id="hp-share"
                    hidden data-title="@Model.Plan.Title">Share</button>
        </div>
    }
    else
    {
        <div class="hp-section">The plan</div>
        <div class="hp-viewer-wrap">
            <div class="hp-viewer">
                <iframe id="hp-pdf" src="@viewerUrl" title="@Model.Plan.Title" loading="lazy"></iframe>
            </div>

            @* Auto-sizing the PDF (below) removes pdf.js's own scroll region so the whole page
               scrolls as one — but that also means its toolbar, which used to stay pinned at the
               top of a small fixed box, now scrolls away with everything else in a long plan.
               This floats independently, reachable no matter how far into the document you've
               scrolled, and is the ONLY way to zoom now that pinch is deliberately disabled. *@
            <div class="hp-zoom" id="hp-zoom" hidden>
                <button type="button" id="hp-zoom-out" aria-label="Zoom out">&#8722;</button>
                <button type="button" id="hp-zoom-in" aria-label="Zoom in">+</button>
            </div>
        </div>

        <div class="hp-row" style="margin-top:.8rem;">
            <a class="hp-btn hp-btn-quiet" href="@downloadUrl">Download PDF</a>
            <button type="button" class="hp-btn hp-btn-quiet" id="hp-share"
                    hidden data-title="@Model.Plan.Title">Share</button>
        </div>
    }

    @if (Model.Ctx.IsManager)
    {
        var total = Model.Viewed.Count + Model.NotViewed.Count;
        <div class="hp-section">Who's seen it</div>
        <div class="hp-panel">
            <strong>@Model.Viewed.Count of @total</strong> on the roster have opened this plan.
            @if (Model.AnonymousViews > 0)
            {
                <span class="hp-muted">
                    Plus @Model.AnonymousViews view@(Model.AnonymousViews == 1 ? "" : "s")
                    from someone who hasn't picked a name (likely a parent).
                </span>
            }

            @if (total > 0)
            {
                <div class="hp-tracking">
                    @foreach (var p in Model.Viewed)
                    {
                        <span class="done">✓ @p.Name</span>
                    }
                    @foreach (var p in Model.NotViewed)
                    {
                        <span>@p.Name</span>
                    }
                </div>
            }
        </div>

        <a class="hp-btn hp-btn-quiet" asp-controller="Coach" asp-action="EditPlan"
           asp-route-slug="@Model.Ctx.Team.Slug" asp-route-id="@Model.Plan.Id">Edit this plan</a>
    }
</div>

<div class="hp-player" id="hp-player" hidden aria-modal="true" role="dialog" aria-label="Drill video">
    <div class="hp-player-backdrop" data-close></div>
    <div class="hp-player-box">
        <div class="hp-player-bar">
            <span class="hp-player-title">
                <span id="hp-player-section" class="hp-player-section"></span>
                <span id="hp-player-title"></span>
            </span>
            <button type="button" class="hp-player-btn" id="hp-player-close"
                    data-close aria-label="Close video">✕</button>
        </div>
        <div class="hp-player-frame"><iframe id="hp-player-frame" title="Drill video"
             allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
             allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
        <div class="hp-player-nav">
            <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-player-prev">← Previous</button>
            <span class="hp-player-count" id="hp-player-count"></span>
            <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-player-next">Next →</button>
        </div>
        <a class="hp-player-out" id="hp-player-out" target="_blank" rel="noopener noreferrer">Open in YouTube instead</a>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // Record the view only once the document has actually rendered — a bounce is not a view,
    // and the coach's "12 of 17" is only worth anything if it means people really looked.
    var pdfFrame = document.getElementById('hp-pdf');
    var sent = false;

    function record() {
        if (sent) return;
        sent = true;
        fetch(@Html.Raw(Json.Serialize(beaconUrl)), {
            method: 'POST',
            credentials: 'same-origin',
            keepalive: true
        }).catch(function () { /* tracking must never break the page */ });
    }

    // ── Disable pdf.js's own pinch-to-zoom, leave the toolbar +/- as the only way ──────
    // Two things fight each other on a pinch gesture over the PDF: the browser's own native
    // page zoom, and pdf.js's internal canvas-zoom handler (which even at its "reduced" setting
    // still zooms in coarse steps, just not smoothly — never fully off). Both listen on
    // touchstart; pdf.js's own listener sits on the iframe's `window` in the bubble phase. A
    // capture-phase listener registered earlier, directly in the iframe's own document (reachable
    // same-origin via the officially documented "webviewerloaded" event pdf.js fires on the
    // PARENT document before it wires anything up), runs first and stops the event outright —
    // so neither system ever sees the gesture, and only the header's +/- buttons do anything.
    document.addEventListener('webviewerloaded', function (e) {
        var pdfWin = e.detail && e.detail.source;
        if (!pdfWin) return;

        try {
            pdfWin.document.addEventListener('touchstart', function (te) {
                if (te.touches.length > 1) {
                    te.preventDefault();
                    te.stopPropagation();
                }
            }, { capture: true, passive: false });

            // Belt and suspenders: if a future pdf.js build changes how its own listener is
            // registered, this still keeps pinch from doing smooth zoom.
            if (pdfWin.PDFViewerApplicationOptions) {
                pdfWin.PDFViewerApplicationOptions.set('supportsPinchToZoom', false);
            }
        } catch (err) { /* cross-origin or a pdf.js internals change — fail open, not broken */ }
    });

    // The viewer is same-origin, so its load event is a real signal that the PDF opened.
    if (pdfFrame) {
        pdfFrame.addEventListener('load', function () { setTimeout(record, 1500); });
    }

    // ── In-page video player ────────────────────────────────────────────
    // Videos play over the plan instead of navigating away. With several drills to watch,
    // a new tab per video leaves a 15-year-old stranded in a stack of tabs and they stop
    // coming back to the plan.
    // Any element carrying data-embed, not just the .hp-video cards: a drill plan's "Watch the
    // drill" buttons join the same list, so Previous/Next walks the practice in order.
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-embed]'))
        .filter(function (c) { return c.dataset.embed; });

    var modal = document.getElementById('hp-player');
    var frame = document.getElementById('hp-player-frame');
    var titleEl = document.getElementById('hp-player-title');
    var sectionEl = document.getElementById('hp-player-section');
    var countEl = document.getElementById('hp-player-count');
    var outEl = document.getElementById('hp-player-out');
    var prevBtn = document.getElementById('hp-player-prev');
    var nextBtn = document.getElementById('hp-player-next');
    var current = -1;
    var opened = false;
    var savedScrollY = 0;

    // Body scroll-lock via overflow:hidden loses the scroll position on close on iOS Safari —
    // it does not reliably restore where you were, which is exactly the "back to the top"
    // report this replaces. Locking with position:fixed and an explicit -Y offset, then
    // reversing that and re-asserting scrollTo on close, is the technique that actually holds
    // the position across every mobile browser, not just desktop ones where overflow:hidden
    // happens to look fine.
    function lockScroll() {
        savedScrollY = window.scrollY || window.pageYOffset || 0;
        document.body.style.position = 'fixed';
        document.body.style.top = (-savedScrollY) + 'px';
        document.body.style.left = '0';
        document.body.style.right = '0';
    }

    function unlockScroll() {
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        window.scrollTo(0, savedScrollY);
    }

    function show(index) {
        if (index < 0 || index >= cards.length) return;
        var card = cards[index];
        current = index;
        open_(card.dataset.embed, card.dataset.label, card.dataset.section, card.href, true);
    }

    // Plays a video that isn't one of the cards — a link inside the PDF the coach hid, or one
    // extraction missed. Prev/Next are meaningless here, so they're hidden.
    function showAdHoc(embed, label, href) {
        current = -1;
        open_(embed, label, '', href, false);
    }

    function open_(embed, label, section, href, inList) {
        frame.src = embed;
        titleEl.textContent = label || 'Video';
        sectionEl.textContent = section || '';
        sectionEl.hidden = !section;
        outEl.href = href;

        var index = current;
        countEl.textContent = inList ? (index + 1) + ' of ' + cards.length : '';
        prevBtn.disabled = !inList || index === 0;
        nextBtn.disabled = !inList || index === cards.length - 1;
        var showNav = inList && cards.length > 1;
        prevBtn.style.visibility = showNav ? '' : 'hidden';
        nextBtn.style.visibility = showNav ? '' : 'hidden';

        modal.hidden = false;
        if (!opened) {
            lockScroll();
            opened = true;
            // A history entry so the phone's Back gesture closes the video rather than
            // leaving the practice plan altogether.
            try { history.pushState({ hpPlayer: true }, ''); } catch (e) { /* ignore */ }
        }
        // preventScroll: focusing the close button must not itself yank the page — it lives
        // inside a fixed-position overlay, so it's always on screen regardless of body scroll.
        document.getElementById('hp-player-close').focus({ preventScroll: true });
    }

    function close(fromPop) {
        if (modal.hidden) return;
        modal.hidden = true;
        frame.src = 'about:blank';   // stops playback and its audio
        unlockScroll();

        if (opened && !fromPop) {
            opened = false;
            try { history.back(); } catch (e) { /* ignore */ }
            // history.back()'s popstate lands on a later tick and can bring its own idea of
            // scroll position with it (this is the other half of the original bug — the
            // browser's own restoration disagreeing with where the video actually opened from,
            // particularly on iOS). Re-assert ours once that settles so it's the final word.
            requestAnimationFrame(function () { window.scrollTo(0, savedScrollY); });
        } else {
            opened = false;
        }

        // preventScroll for the same reason as on open — returning focus to the card that was
        // tapped must not re-scroll to it; the whole point is staying exactly where you were.
        if (current >= 0 && cards[current]) cards[current].focus({ preventScroll: true });
    }

    cards.forEach(function (card, index) {
        card.addEventListener('click', function (e) {
            // Let modified clicks and middle-clicks behave normally.
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
            e.preventDefault();
            show(index);
        });
    });

    if (modal) {
        modal.addEventListener('click', function (e) {
            if (e.target.hasAttribute('data-close')) close(false);
        });
        prevBtn.addEventListener('click', function () { show(current - 1); });
        nextBtn.addEventListener('click', function () { show(current + 1); });
        document.addEventListener('keydown', function (e) {
            if (modal.hidden) return;
            if (e.key === 'Escape') close(false);
            if (e.key === 'ArrowRight') show(current + 1);
            if (e.key === 'ArrowLeft') show(current - 1);
        });
        window.addEventListener('popstate', function () { close(true); });
    }

    // ── Links inside the PDF itself ─────────────────────────────────────
    // pdf.js renders link annotations as real anchors, and by default they navigate the
    // current tab — which throws the player out of the plan entirely and leaves them
    // hitting Back. The viewer is same-origin, so we can catch those clicks and route
    // them into the same in-page player the cards use.

    function providerId(url) {
        var yt = url.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/i);
        if (yt) { return 'yt:' + yt[1]; }
        var vm = url.match(/vimeo\.com\/(?:video\/)?(\d{6,})/i);
        if (vm) { return 'vm:' + vm[1]; }
        return null;
    }

    function embedFor(id) {
        var parts = id.split(':');
        if (parts[0] === 'yt') {
            return 'https://www.youtube-nocookie.com/embed/' + parts[1] +
                   '?autoplay=1&rel=0&playsinline=1&modestbranding=1';
        }
        return 'https://player.vimeo.com/video/' + parts[1] + '?autoplay=1&playsinline=1';
    }

    function interceptPdfLinks() {
        var doc;
        try {
            doc = pdfFrame.contentDocument;
        } catch (e) {
            return;   // cross-origin for some reason; leave the viewer's own behaviour alone
        }
        if (!doc || doc.__hpBound) return;
        doc.__hpBound = true;

        doc.addEventListener('click', function (e) {
            var anchor = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!anchor) return;

            // Internal navigation (page jumps, the outline) resolves to our own origin —
            // leave those to the viewer.
            var href = anchor.href;
            if (!/^https?:/i.test(href)) return;
            if (href.indexOf(window.location.origin) === 0) return;

            e.preventDefault();
            e.stopPropagation();

            var id = providerId(href);
            if (id) {
                for (var i = 0; i < cards.length; i++) {
                    if (cards[i].dataset.vid === id) { show(i); return; }
                }
                showAdHoc(embedFor(id), anchor.textContent || 'Video', href);
                return;
            }

            // Not a video we can embed — open it away from the plan rather than replacing it.
            window.open(href, '_blank', 'noopener');
        }, true);
    }

    // ── Auto-height the PDF, so it's one continuous scroll instead of a scroll-within-a-
    // scroll ──────────────────────────────────────────────────────────────────────────
    // A fixed-height iframe gives pdf.js its own internal scroll region. Once that's scrolled
    // to its end, the gesture is trapped there rather than continuing onto the rest of the
    // page — you have to lift your finger and start a fresh touch outside the iframe's box to
    // keep scrolling. Removing the separate scroll region entirely removes the whole class of
    // "trapped scroll" problem: measure the document's real rendered height and set the
    // iframe's own height to match, so the outer page's normal scroll carries through the
    // whole plan, PDF included, the same way it would through a long article.
    function autoSizePdfFrame() {
        try {
            var doc = pdfFrame.contentWindow && pdfFrame.contentWindow.document;
            var ResizeObserverCtor = pdfFrame.contentWindow && pdfFrame.contentWindow.ResizeObserver;
            if (!doc || !ResizeObserverCtor) return;   // older browser: keep the CSS min-height fallback

            var container = doc.getElementById('viewerContainer');
            if (!container) return;
            var toolbar = doc.getElementById('toolbarContainer');

            // #viewerContainer is what scrolls (overflow:auto, absolutely positioned to fill
            // the iframe's own viewport) — its OWN box size does NOT grow as pages render in;
            // that's the entire point of overflow:auto, content overflows a fixed box instead
            // of resizing it. #viewer, the plain block-flow div pdf.js stacks page elements
            // into, is what actually grows with content — THAT'S what has to be observed for
            // the callback to fire as rendering progresses. scrollHeight (queried on the
            // scrollable container) is still the right measurement, just not the right thing
            // to attach the observer to.
            var content = doc.getElementById('viewer') || container;

            var lastHeight = 0;
            function apply() {
                var toolbarHeight = toolbar ? toolbar.offsetHeight : 0;
                var total = toolbarHeight + container.scrollHeight;

                // Ignore sub-pixel/rounding jitter so this doesn't fire on every ResizeObserver
                // tick — that's how you get the "ResizeObserver loop" warning and janky layout.
                if (Math.abs(total - lastHeight) < 2) return;
                lastHeight = total;
                pdfFrame.style.height = total + 'px';
            }

            apply();
            var ro = new ResizeObserverCtor(apply);
            ro.observe(content);
            if (toolbar) ro.observe(toolbar);   // toolbar height can change (narrow-width wrapping)
        } catch (err) {
            // pdf.js internals changed, or something cross-origin — the CSS min-height fallback
            // means the viewer still works, just back to its own internal scroll.
        }
    }

    // ── Floating zoom control ────────────────────────────────────────────────────────
    // pdf.js's own toolbar used to stay reachable for free — pinned at the top of a small
    // fixed box while its content scrolled underneath. Auto-sizing removes that separate
    // scroll region (see above), so the toolbar is now just the first thing in a very tall
    // element and scrolls away like anything else. Since pinch-to-zoom is deliberately
    // disabled on this viewer, losing easy access to zoom entirely would trade one rough edge
    // for a worse one. This calls straight into pdf.js's own zoom methods.
    function wireZoomControl() {
        var zoomBar = document.getElementById('hp-zoom');
        var zoomIn = document.getElementById('hp-zoom-in');
        var zoomOut = document.getElementById('hp-zoom-out');
        if (!zoomBar || !pdfFrame) return;

        function app() {
            var w = pdfFrame.contentWindow;
            return w && w.PDFViewerApplication;
        }

        zoomIn.addEventListener('click', function () {
            var a = app();
            if (a) { try { a.zoomIn(); } catch (e) { /* ignore */ } }
        });
        zoomOut.addEventListener('click', function () {
            var a = app();
            if (a) { try { a.zoomOut(); } catch (e) { /* ignore */ } }
        });

        // Only worth showing while the plan is actually on screen — not while reading the
        // video cards above it, and not once scrolled down to the tracking/download section.
        if ('IntersectionObserver' in window) {
            var wrap = document.querySelector('.hp-viewer-wrap');
            if (wrap) {
                new IntersectionObserver(function (entries) {
                    zoomBar.hidden = !entries[0].isIntersecting;
                }, { threshold: 0.05 }).observe(wrap);
            }
        } else {
            zoomBar.hidden = false;   // no IntersectionObserver: fall back to always-visible
        }
    }

    if (pdfFrame) {
        // Delegated on the iframe's document, so it survives the viewer re-rendering its
        // annotation layer on scroll or zoom — no polling needed.
        pdfFrame.addEventListener('load', interceptPdfLinks);
        pdfFrame.addEventListener('load', autoSizePdfFrame);
        interceptPdfLinks();   // in case the frame finished before this script ran
        autoSizePdfFrame();
        wireZoomControl();
    }

    // A drill plan has no PDF frame, so the load event above never fires and nothing would ever
    // be recorded — the coach's "12 of 17" would sit at zero while looking like it worked. Same
    // intent as the PDF path: count it once the content is actually on screen, not on page load,
    // so a bounce isn't a view. record() is guarded, so the two paths can't double-count.
    var drillList = document.getElementById('hp-drills');
    if (!pdfFrame && drillList) {
        setTimeout(record, 2000);
    }

    // Native share sheet, for pasting into the team group chat. Hidden where unsupported.
    var share = document.getElementById('hp-share');
    if (share && navigator.share) {
        share.hidden = false;
        share.addEventListener('click', function () {
            navigator.share({ title: share.dataset.title, url: window.location.href })
                .catch(function () { /* user dismissed */ });
        });
    }
})();
</script>
}
