@using HockeyPractice.Services
@model DrillEditViewModel
@{
    ViewBag.Title = (Model.IsNew ? "New drill" : "Edit drill") + " – " + Model.Ctx.Team.Name;
    ViewBag.Team = Model.Ctx.Team;
    var slug = Model.Ctx.Team.Slug;
}
@await Html.PartialAsync("_TeamHeader", Model.Ctx)

<div class="hp-shell">
    <h1 class="hp-title">@(Model.IsNew ? "New drill" : "Edit drill")</h1>

    @if (Model.Notice is not null)
    {
        <div class="hp-notice">@Model.Notice</div>
    }
    @if (Model.Error is not null)
    {
        <div class="hp-error">@Model.Error</div>
    }

    @if (!Model.IsNew && Model.UsedInPlans > 0)
    {
        <div class="hp-muted" style="margin-top:.4rem;">
            Used in @Model.UsedInPlans plan@(Model.UsedInPlans == 1 ? "" : "s") — changes here show
            up in @(Model.UsedInPlans == 1 ? "it" : "all of them").
        </div>
    }

    @* enctype matters: without it the browser posts the filename only and the file arrives null,
       with nothing to indicate anything went wrong. *@
    <form method="post" enctype="multipart/form-data" class="hp-form" style="margin-top:1rem;"
          id="hp-drill-form"
          asp-action="@(Model.IsNew ? "Create" : "Update")"
          asp-route-slug="@slug" asp-route-id="@Model.Drill?.Id">
        @Html.AntiForgeryToken()
        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        }

        <div class="hp-field">
            <label class="hp-label" for="title">Drill name</label>
            <input class="hp-input" id="title" name="title" required maxlength="140"
                   value="@Model.TitleValue" placeholder="e.g. D-to-D reversal breakout" />
        </div>

        <div class="hp-field">
            <label class="hp-label" for="description">How it's run</label>
            <textarea class="hp-textarea" id="description" name="description" maxlength="4000"
                      style="min-height:9rem;"
                      placeholder="Setup, the progression, coaching points…">@Model.DescriptionValue</textarea>
        </div>

        <div class="hp-field">
            <label class="hp-label" for="runTimeMinutes">Approx. run time (minutes)</label>
            @* type=number with inputmode=numeric so a phone shows the digit pad. The real bounds
               check is server-side; min/max here just steer the spinner. *@
            <input class="hp-input" type="number" id="runTimeMinutes" name="runTimeMinutes"
                   min="1" max="@HockeyPractice.Infrastructure.RunTime.MaxMinutes" step="1"
                   inputmode="numeric" value="@Model.RunTimeValue" placeholder="e.g. 12" />
            <span class="hp-muted" style="font-size:.8rem;">
                Added up across a plan so you can see whether practice fits your ice time. Leave
                blank if you're not sure &mdash; the total will say how many are unset.
            </span>
        </div>

        @await Html.PartialAsync("_TagEditor", new TagEditorModel
        {
            Name = "tags",
            Id = "drilltags",
            Label = "Drill tags",
            Placeholder = "Type a tag, or pick an existing one",
            Hint = "How you'll find this drill later when building a plan. Press Enter or Add tag "
                 + "to add each one.",
            Current = Model.TagsValue,
            Known = Model.AllTags,
            Max = HockeyPractice.Controllers.DrillController.MaxTags
        })

        <div class="hp-field">
            <label class="hp-label" for="videoUrl">Video link (optional)</label>
            <input class="hp-input" id="videoUrl" name="videoUrl" maxlength="500" inputmode="url"
                   value="@Model.VideoUrlValue" placeholder="https://youtu.be/…" />
            <span class="hp-muted" style="font-size:.8rem;">
                Paste a YouTube or Vimeo link and it plays right inside the plan. Other links open
                in a new tab. Leave it blank and no video button shows.
            </span>
        </div>

        <div class="hp-field">
            <label class="hp-label" for="diagram">Pictures (optional)</label>

            @* The file input used to be the whole box, so clicking anywhere near it — including
               when you only meant to aim a paste — threw open the file dialog. It's now hidden
               behind an explicit button, and the box itself is a focusable paste target. The
               input keeps its name and stays inside the form, so a hidden file input still
               posts its files exactly as before. *@
            <div class="hp-pastebox" id="hp-pastebox" tabindex="0" role="button"
                 aria-describedby="hp-pastebox-hint">
                <span class="hp-pastebox-main">Click here, then paste a picture</span>
                <span class="hp-pastebox-sub" id="hp-pastebox-hint">
                    Cmd/Ctrl + V &mdash; or drag one onto the page
                </span>
                <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-pick">
                    Choose files instead
                </button>
            </div>

            <input type="file" id="diagram" name="diagrams" multiple hidden
                   accept="image/*,application/pdf,.pdf" />

            @* Filled in by the paste/drop script. Hidden until something is actually staged, so a
               coach is never looking at an empty box wondering whether it worked. *@
            @* The label rides on a data attribute rather than being interpolated into the script
               below. Same lesson as the layout's data-confirm: a value dropped straight into a JS
               string literal breaks the moment it contains an apostrophe, and a script that fails
               to parse fails silently. *@
            <div class="hp-paste-preview" id="hp-paste-preview" hidden
                 data-ready-label="Ready to save">
                <img id="hp-paste-thumb" alt="The diagram about to be saved" hidden />
                <span class="hp-paste-chip" id="hp-paste-chip" hidden></span>
                <div class="hp-paste-note">
                    <span id="hp-paste-label"></span>
                    @* type="button" is load-bearing: a bare <button> in a form defaults to submit,
                       so clearing the diagram would save the drill instead. *@
                    <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-paste-clear">
                        Clear
                    </button>
                </div>
            </div>

            <span class="hp-muted" style="font-size:.8rem;">
                Photos and screenshots show right inside the plan, and get shrunk automatically. A
                PDF shows as a link players tap to open &mdash; images are easier to read on a phone.
                You can pick several at once, <strong>paste screenshots</strong> straight in, or
                drag them onto this page. Up to
                @HockeyPractice.Controllers.DrillController.MaxDiagrams per drill, in the order you
                add them.
                @if (Model.Drill is not null && Model.Drill.Diagrams.Count > 0)
                {
                    <text>New ones are added to the list above, not swapped in.</text>
                }
            </span>
        </div>

        <button type="submit" class="hp-btn hp-btn-block" data-busy="Saving…">
            @(Model.IsNew ? "Save drill" : "Save changes")
        </button>
    </form>

    @* Outside the form above: nested forms are invalid HTML and the browser drops the inner one,
       which would make these buttons submit the edit form instead. Keeping the Remove buttons out
       here also means clicking one doesn't re-upload a picture staged in the form and then throw
       it away — which on rink wifi would be a slow way to achieve nothing. *@
    @if (!Model.IsNew && Model.Drill is { } d && d.Diagrams.Count > 0)
    {
        <div class="hp-section">Pictures on this drill</div>
        <div class="hp-panel">
            <p class="hp-muted" style="margin-top:0;font-size:.82rem;">
                Shown to players in this order &mdash; the order they were added.
            </p>
            <div class="hp-diagram-grid">
                @foreach (var picture in d.Diagrams.OrderBy(x => x.Id))
                {
                    var url = Url.Action("Diagram", new { slug, id = d.Id, diagramId = picture.Id });
                    <div class="hp-diagram-item">
                        @if (picture.IsPdf)
                        {
                            <a class="hp-paste-chip" href="@url" target="_blank" rel="noopener noreferrer">
                                PDF
                            </a>
                        }
                        else
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer">
                                <img class="hp-drill-diagram" style="max-height:9rem;margin-top:0;"
                                     src="@url" alt="Picture on @d.Title" />
                            </a>
                        }
                        <div class="hp-muted" style="font-size:.75rem;">
                            @PlanStorageService.Human(picture.Bytes)
                        </div>
                        <form method="post" asp-action="RemoveDiagram" asp-route-slug="@slug"
                              asp-route-id="@d.Id" asp-route-diagramId="@picture.Id"
                              data-confirm="Remove this picture from the drill?">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="hp-btn hp-btn-danger hp-btn-sm">Remove</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    @if (!Model.IsNew && Model.Drill is not null)
    {
        <div class="hp-section">This drill</div>
        <div class="hp-panel">
            @if (Model.Drill.IsArchived)
            {
                <p class="hp-muted" style="margin-top:0;">
                    Archived — it doesn't show up when building a plan, but plans already using it
                    are unaffected.
                </p>
                <form method="post" asp-action="Unarchive" asp-route-slug="@slug" asp-route-id="@Model.Drill.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="hp-btn hp-btn-quiet">Put back in the library</button>
                </form>
            }
            else
            {
                <p class="hp-muted" style="margin-top:0;">
                    Archiving hides a drill from the picker without touching the plans that already
                    use it. That's the safe way to retire one.
                </p>
                <form method="post" asp-action="Archive" asp-route-slug="@slug" asp-route-id="@Model.Drill.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="hp-btn hp-btn-quiet">Archive</button>
                </form>
            }

            <form method="post" asp-action="Delete" asp-route-slug="@slug" asp-route-id="@Model.Drill.Id"
                  style="margin-top:.8rem;"
                  data-confirm="Delete this drill for good? This can't be undone.">
                @Html.AntiForgeryToken()
                <button type="submit" class="hp-btn hp-btn-danger">Delete drill</button>
            </form>
            <div class="hp-muted" style="font-size:.78rem;margin-top:.3rem;">
                @if (Model.UsedInPlans > 0)
                {
                    <text>
                        Used in @Model.UsedInPlans plan@(Model.UsedInPlans == 1 ? "" : "s"), so it
                        can't be deleted — archive it instead.
                    </text>
                }
                else
                {
                    <text>Not used in any plan, so this will remove it and its diagram.</text>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    // A coach clipping a diagram out of a PDF or a video already has it on the clipboard, and
    // hunting through the file picker for something they just copied is the slow way round. Paste
    // and drag both end up in the same place: the real <input type="file">, so the upload goes
    // through the exact same validation, shrinking and storage as picking a file by hand.
    var input = document.getElementById('diagram');
    var form = document.getElementById('hp-drill-form');
    if (!input || !form) return;

    var pastebox = document.getElementById('hp-pastebox');
    var pick = document.getElementById('hp-pick');
    var preview = document.getElementById('hp-paste-preview');
    var thumb = document.getElementById('hp-paste-thumb');
    var chip = document.getElementById('hp-paste-chip');
    var label = document.getElementById('hp-paste-label');
    var clear = document.getElementById('hp-paste-clear');
    var objectUrl = null;

    // Assigning to input.files works everywhere current but throws on older Safari. If it does,
    // leave the file picker exactly as it was and say nothing — the coach still has a way in.
    function canInject() {
        try { return typeof DataTransfer === 'function' && !!new DataTransfer(); }
        catch (e) { return false; }
    }

    function releaseUrl() {
        if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
    }

    function showPreview() {
        releaseUrl();

        var staged = input.files ? Array.prototype.slice.call(input.files) : [];
        if (!staged.length) { hidePreview(); return; }

        // Preview the most recent one — a strip of thumbnails would crowd the form, and the count
        // beside it is what actually answers "did all four land?".
        var file = staged[staged.length - 1];
        var isImage = file.type && file.type.indexOf('image/') === 0;

        if (isImage) {
            objectUrl = URL.createObjectURL(file);
            thumb.src = objectUrl;
            thumb.hidden = false;
            chip.hidden = true;
        } else {
            // A PDF has nothing to show, so name it rather than render a broken image.
            chip.textContent = file.name || 'PDF';
            chip.hidden = false;
            thumb.hidden = true;
        }

        var base = preview.dataset.readyLabel || 'Ready to save';
        label.textContent = staged.length === 1
            ? base
            : staged.length + ' pictures ready to save';
        preview.hidden = false;
    }

    function hidePreview() {
        releaseUrl();
        preview.hidden = true;
        thumb.hidden = true;
        chip.hidden = true;
        thumb.removeAttribute('src');
    }

    // Adds to what's already staged rather than replacing it. A drill can hold several pictures,
    // so pasting a second screenshot has to build the set up — replacing would silently discard
    // the first and there'd be nothing on screen to say so.
    function accept(newFiles) {
        var incoming = (newFiles || []).filter(function (f) { return f; });
        if (!incoming.length || !canInject()) return false;

        try {
            var dt = new DataTransfer();
            var existing = input.files ? Array.prototype.slice.call(input.files) : [];
            existing.concat(incoming).forEach(function (f) { dt.items.add(f); });
            input.files = dt.files;
        } catch (e) {
            return false;   // leave whatever the picker already had alone
        }

        showPreview();
        return true;
    }

    // ── Paste ────────────────────────────────────────────────────────
    // Only acts on a paste that actually carries a file. Pasting text into the description has to
    // keep behaving normally, so there is no preventDefault unless a file is really there.
    document.addEventListener('paste', function (e) {
        var items = e.clipboardData && e.clipboardData.items;
        if (!items) return;

        var found = [];
        for (var i = 0; i < items.length; i++) {
            if (items[i].kind !== 'file') continue;
            var file = items[i].getAsFile();
            if (file) found.push(file);
        }
        if (found.length && accept(found)) e.preventDefault();
    });

    // ── Drag and drop ────────────────────────────────────────────────
    // Bound to the whole document, not just the form. Without preventDefault the browser opens a
    // dropped file as a page and the half-filled form is gone — and a near miss outside the form
    // is exactly when that would happen, so catching it only over the form would leave the
    // footgun loaded. Dragging an image onto this page has one obvious meaning; take it wherever
    // it lands.
    function hasFiles(e) {
        var types = e.dataTransfer && e.dataTransfer.types;
        // types is a plain array in current browsers and a DOMStringList in older ones; the
        // borrowed indexOf handles both.
        return !!types && Array.prototype.indexOf.call(types, 'Files') !== -1;
    }

    ['dragenter', 'dragover'].forEach(function (name) {
        document.addEventListener(name, function (e) {
            if (!hasFiles(e)) return;
            e.preventDefault();
            form.classList.add('hp-dropping');
        });
    });

    ['dragleave', 'dragend'].forEach(function (name) {
        document.addEventListener(name, function (e) {
            // Only when the pointer has actually left the window, not on the stream of leave
            // events fired while crossing elements inside it.
            if (name === 'dragleave' && e.relatedTarget) return;
            form.classList.remove('hp-dropping');
        });
    });

    document.addEventListener('drop', function (e) {
        if (!hasFiles(e)) return;
        e.preventDefault();
        form.classList.remove('hp-dropping');

        var files = e.dataTransfer.files;
        if (files && files.length) accept(Array.prototype.slice.call(files));
    });

    // Choosing a file by hand after pasting must win, and must be what the preview shows.
    input.addEventListener('change', showPreview);

    clear.addEventListener('click', function () {
        input.value = '';
        hidePreview();
    });

    // Only this button opens the file dialog. Clicking the box around it just arms it for a
    // paste — which is the whole point of separating the two.
    if (pick) {
        pick.addEventListener('click', function (e) {
            e.stopPropagation();   // don't also re-focus the box behind it
            input.click();
        });
    }

    if (pastebox) {
        // Focusing gives a visible "ready" state. Paste itself is still bound to the document,
        // so a coach who pastes without clicking here first is not punished for it — the box
        // makes the gesture discoverable rather than mandatory.
        pastebox.addEventListener('click', function () { pastebox.focus(); });

        // A focusable div isn't a button to a keyboard or screen reader unless Enter and Space
        // do something. Both open the picker, which is the only action available here.
        pastebox.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault();
            input.click();
        });
    }

    // Coming back via the Back button restores the page from the bfcache, but a file put into the
    // input by script does not reliably come back with it. Without this the preview would still be
    // sitting there promising a diagram that is no longer attached, and saving would quietly drop
    // it. Clear both so the form can't lie about what it's about to send.
    window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        input.value = '';
        hidePreview();
    });
})();
</script>
}
