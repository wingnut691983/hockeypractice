@using HockeyPractice.Services
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@model DrillEditViewModel
@{
    ViewBag.Title = (Model.IsNew ? "New drill" : "Edit drill") + " – " + Model.Ctx.Team.Name;
    ViewBag.Team = Model.Ctx.Team;
    var slug = Model.Ctx.Team.Slug;

    // The drawing editor is loaded only when Draw is pressed. asp-append-version works on tags,
    // not on a URL a script reads later, so the versioned path is built here; without the hash a
    // redeploy could leave a coach running yesterday's editor from cache.
    var sketchSrc = FileVersions.AddFileVersionToPath(Context.Request.PathBase, "/js/drill-sketch.js");
    var draftKey = $"hp-sketch:{slug}:{(Model.Drill?.Id.ToString() ?? "new")}";
    var room = HockeyPractice.Controllers.DrillController.MaxDiagrams - (Model.Drill?.Diagrams.Count ?? 0);
}
@await Html.PartialAsync("_TeamHeader", Model.Ctx)

<div class="hp-shell">
    <h1 class="hp-title">@(Model.IsNew ? "New drill" : "Edit drill")</h1>

    @if (Model.Notice is not null)
    {
        <div class="hp-notice">@Model.Notice</div>
    }
    @if (Model.Error is not null)
    {
        <div class="hp-error">@Model.Error</div>
    }

    @if (!Model.IsNew && Model.UsedInPlans > 0)
    {
        <div class="hp-muted" style="margin-top:.4rem;">
            Used in @Model.UsedInPlans plan@(Model.UsedInPlans == 1 ? "" : "s"), so changes here show
            up in @(Model.UsedInPlans == 1 ? "it" : "all of them").
        </div>
    }

    @* enctype matters: without it the browser posts the filename only and the file arrives null,
       with nothing to indicate anything went wrong. *@
    <form method="post" enctype="multipart/form-data" class="hp-form" style="margin-top:1rem;"
          id="hp-drill-form"
          data-failed="@(Model.Error is not null ? "1" : null)"
          asp-action="@(Model.IsNew ? "Create" : "Update")"
          asp-route-slug="@slug" asp-route-id="@Model.Drill?.Id">
        @Html.AntiForgeryToken()
        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        }

        <div class="hp-field">
            <label class="hp-label" for="title">Drill name</label>
            <input class="hp-input" id="title" name="title" required maxlength="140"
                   value="@Model.TitleValue" placeholder="e.g. D-to-D reversal breakout" />
        </div>

        <div class="hp-field">
            <label class="hp-label" for="description">How it's run</label>
            <textarea class="hp-textarea" id="description" name="description" maxlength="4000"
                      style="min-height:9rem;"
                      placeholder="Setup, the progression, coaching points…">@Model.DescriptionValue</textarea>
        </div>

        <div class="hp-field">
            <label class="hp-label" for="runTimeMinutes">Approx. run time (minutes)</label>
            @* type=number with inputmode=numeric so a phone shows the digit pad. The real bounds
               check is server-side; min/max here just steer the spinner.

               required only on a new drill, matching ValidateFields: older drills and copies of
               them have no run time, and forcing one before an unrelated edit can be saved would
               be a tax on drills that pre-date the rule. *@
            <input class="hp-input" type="number" id="runTimeMinutes" name="runTimeMinutes"
                   min="1" max="@HockeyPractice.Infrastructure.RunTime.MaxMinutes" step="1"
                   inputmode="numeric" value="@Model.RunTimeValue" placeholder="e.g. 12"
                   required="@(Model.IsNew ? "required" : null)" />
            <span class="hp-muted" style="font-size:.8rem;">
                Added up across a plan so you can see whether practice fits your ice time.
                @if (Model.IsNew)
                {
                    <text>A rough guess is fine. You can change it later.</text>
                }
                else
                {
                    <text>
                        Leave blank if you're not sure. The total will say how many are
                        unset.
                    </text>
                }
            </span>
        </div>

        @await Html.PartialAsync("_TagEditor", new TagEditorModel
        {
            Name = "tags",
            Id = "drilltags",
            Label = "Drill tags",
            Placeholder = "Type a tag, or pick an existing one",
            Hint = "Reusing the same tags is what makes the library searchable later.",
            Current = Model.TagsValue,
            Known = Model.AllTags,
            Max = HockeyPractice.Controllers.DrillController.MaxTags
        })

        <div class="hp-field">
            <label class="hp-label" for="videoUrl">Video link (optional)</label>
            <input class="hp-input" id="videoUrl" name="videoUrl" maxlength="500" inputmode="url"
                   value="@Model.VideoUrlValue" placeholder="https://youtu.be/…" />
            <span class="hp-muted" style="font-size:.8rem;">
                Paste a YouTube or Vimeo link and it plays right inside the plan. Other links open
                in a new tab. Leave it blank and no video button shows.
            </span>
        </div>

        <div class="hp-field">
            <label class="hp-label" for="diagram">Pictures (optional)</label>

            @* The file input used to be the whole box, so clicking anywhere near it — including
               when you only meant to aim a paste — threw open the file dialog. It's now hidden
               behind an explicit button, and the box itself is a focusable paste target. The
               input keeps its name and stays inside the form, so a hidden file input still
               posts its files exactly as before. *@
            <div class="hp-pastebox" id="hp-pastebox" tabindex="0" role="button"
                 aria-describedby="hp-pastebox-hint">
                <span class="hp-pastebox-main">Click here, then paste a picture</span>
                <span class="hp-pastebox-sub" id="hp-pastebox-hint">
                    Cmd/Ctrl + V, or drag one onto the page
                </span>
                <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-pick">
                    Choose files instead
                </button>
            </div>

            <input type="file" id="diagram" name="diagrams" multiple hidden
                   accept="image/*,application/pdf,.pdf" />

            @* Script-only, so hidden until the staging script below finds it can attach a file. A
               drawing is staged exactly as a pasted picture is, and its editable copy rides in a
               hidden field named for that file (hp-sketch-fields). *@
            <div class="hp-draw-row" id="hp-draw-row" hidden
                 data-src="@sketchSrc" data-draft="@draftKey" data-room="@room">
                <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-draw">
                    Draw a diagram
                </button>
                <span class="hp-draw-note" id="hp-draw-note" aria-live="polite"></span>
            </div>
            <div id="hp-sketch-fields" hidden></div>

            @* Filled in by the paste/drop script. Hidden until something is actually staged, so a
               coach is never looking at an empty box wondering whether it worked. *@
            @* The label rides on a data attribute rather than being interpolated into the script
               below. Same lesson as the layout's data-confirm: a value dropped straight into a JS
               string literal breaks the moment it contains an apostrophe, and a script that fails
               to parse fails silently. *@
            <div class="hp-paste-preview" id="hp-paste-preview" hidden
                 data-ready-label="Ready to save">
                <img id="hp-paste-thumb" alt="The diagram about to be saved" hidden />
                <span class="hp-paste-chip" id="hp-paste-chip" hidden></span>
                <div class="hp-paste-note">
                    <span id="hp-paste-label"></span>
                    @* type="button" is load-bearing: a bare <button> in a form defaults to submit,
                       so clearing the diagram would save the drill instead. *@
                    <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-paste-clear">
                        Clear
                    </button>
                </div>
            </div>

            <span class="hp-muted" style="font-size:.8rem;">
                Photos and screenshots show right inside the plan, and get shrunk automatically. A
                PDF shows as a link players tap to open; images are easier to read on a phone.
                You can pick several at once, <strong>paste screenshots</strong> straight in, or
                drag them onto this page. Up to
                @HockeyPractice.Controllers.DrillController.MaxDiagrams per drill, in the order you
                add them.
                @if (Model.Drill is not null && Model.Drill.Diagrams.Count > 0)
                {
                    <text>New ones are added to the list above, not swapped in.</text>
                }
            </span>
        </div>

        <button type="submit" class="hp-btn hp-btn-block" data-busy="Saving…">
            @(Model.IsNew ? "Save drill" : "Save changes")
        </button>
    </form>

    @* Outside the form above: nested forms are invalid HTML and the browser drops the inner one,
       which would make these buttons submit the edit form instead. Keeping the Remove buttons out
       here also means clicking one doesn't re-upload a picture staged in the form and then throw
       it away — which on rink wifi would be a slow way to achieve nothing. *@
    @if (!Model.IsNew && Model.Drill is { } d && d.Diagrams.Count > 0)
    {
        <h2 class="hp-section">Pictures on this drill</h2>
        <div class="hp-panel">
            <p class="hp-muted" style="margin-top:0;font-size:.82rem;">
                Shown to players in the order they were added.
            </p>
            <div class="hp-diagram-grid">
                @{ var position = 0; }
                @foreach (var picture in d.Diagrams.OrderBy(x => x.Id))
                {
                    position++;
                    var url = Url.Action("Diagram", new { slug, id = d.Id, diagramId = picture.Id, v = picture.Version });
                    Model.Sketches.TryGetValue(picture.Id, out var sketchJson);
                    @* The drawing goes to the editor in a data attribute, which Razor encodes. It is
                       never rendered as markup: the editor sets all of its text with textContent,
                       which matters because a copied drill carries another team's labels. *@
                    <div class="hp-diagram-item" data-diagram-id="@picture.Id"
                         data-position="@position"
                         data-sketch="@sketchJson"
                         data-sketch-url="@(sketchJson is null ? null : Url.Action("ReplaceSketch", new { slug, id = d.Id, diagramId = picture.Id }))">
                        @if (picture.IsPdf)
                        {
                            <a class="hp-paste-chip" href="@url" target="_blank" rel="noopener noreferrer">
                                PDF
                            </a>
                        }
                        else
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer">
                                <img class="hp-drill-diagram" style="max-height:9rem;margin-top:0;"
                                     src="@url" alt="@(picture.AltText ?? $"Picture on {d.Title}")" />
                            </a>
                        }
                        <div class="hp-muted" style="font-size:.75rem;">
                            @PlanStorageService.Human(picture.Bytes)
                        </div>
                        <div class="hp-diagram-actions">
                            @if (sketchJson is not null)
                            {
                                <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm hp-edit-drawing" hidden>
                                    Edit drawing
                                </button>
                                <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm hp-copy-drawing" hidden>
                                    Copy as next stage
                                </button>
                            }
                            <form method="post" asp-action="RemoveDiagram" asp-route-slug="@slug"
                                  asp-route-id="@d.Id" asp-route-diagramId="@picture.Id"
                                  data-confirm="Remove this picture from the drill?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="hp-btn hp-btn-danger hp-btn-sm">Remove</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* Outside the edit form for the same reason the Remove buttons are: a nested form is invalid
       HTML and the browser drops the inner one, so this would submit the edit instead. *@
    @if (!Model.IsNew && Model.Drill is not null && Model.CopyTargets.Count > 0)
    {
        <h2 class="hp-section">Copy this drill</h2>
        <div class="hp-panel">
            <p class="hp-muted" style="margin-top:0;">
                Sends a copy to another team you manage. They get their own to edit, so changes
                here won't reach it afterwards.
            </p>

            @if (Model.CopiedTo.Count > 0)
            {
                <p class="hp-muted" style="font-size:.82rem;">
                    Already copied to <strong>@string.Join(", ", Model.CopiedTo)</strong>.
                    Copying again won't overwrite anything they've changed.
                </p>
            }

            <form method="post" asp-action="Copy" asp-route-slug="@slug" asp-route-id="@Model.Drill.Id"
                  class="hp-row">
                @Html.AntiForgeryToken()
                <select class="hp-select" name="targetSlug" aria-label="Team to copy this drill to"
                        style="flex:1;min-width:11rem;">
                    @foreach (var team in Model.CopyTargets)
                    {
                        <option value="@team.Slug">@team.Name</option>
                    }
                </select>
                <button type="submit" class="hp-btn" data-busy="Copying…">Copy</button>
            </form>

            <p class="hp-muted" style="font-size:.78rem;margin-bottom:0;">
                Copying several at once?
                <a asp-action="CopyTo" asp-route-slug="@slug">Pick from the whole library</a>.
            </p>
        </div>
    }

    @if (!Model.IsNew && Model.Drill is not null)
    {
        <h2 class="hp-section">This drill</h2>
        <div class="hp-panel">
            @if (Model.Drill.IsArchived)
            {
                <p class="hp-muted" style="margin-top:0;">
                    Archived. It doesn't show up when building a plan, but plans already using it
                    are unaffected.
                </p>
                <form method="post" asp-action="Unarchive" asp-route-slug="@slug" asp-route-id="@Model.Drill.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="hp-btn hp-btn-quiet">Put back in the library</button>
                </form>
            }
            else
            {
                <p class="hp-muted" style="margin-top:0;">
                    Archiving hides a drill from the picker without touching the plans that already
                    use it. That's the safe way to retire one.
                </p>
                <form method="post" asp-action="Archive" asp-route-slug="@slug" asp-route-id="@Model.Drill.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="hp-btn hp-btn-quiet">Archive</button>
                </form>
            }

            <form method="post" asp-action="Delete" asp-route-slug="@slug" asp-route-id="@Model.Drill.Id"
                  style="margin-top:.8rem;"
                  data-confirm="Delete this drill for good? This can't be undone.">
                @Html.AntiForgeryToken()
                <button type="submit" class="hp-btn hp-btn-danger">Delete drill</button>
            </form>
            <div class="hp-muted" style="font-size:.78rem;margin-top:.3rem;">
                @if (Model.UsedInPlans > 0)
                {
                    <text>
                        Used in @Model.UsedInPlans plan@(Model.UsedInPlans == 1 ? "" : "s"), so it
                        can't be deleted. Archive it instead.
                    </text>
                }
                else
                {
                    <text>Not used in any plan, so this will remove it and its diagram.</text>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    // A coach clipping a diagram out of a PDF or a video already has it on the clipboard, and
    // hunting through the file picker for something they just copied is the slow way round. Paste
    // and drag both end up in the same place: the real <input type="file">, so the upload goes
    // through the exact same validation, shrinking and storage as picking a file by hand.
    var input = document.getElementById('diagram');
    var form = document.getElementById('hp-drill-form');
    if (!input || !form) return;

    var pastebox = document.getElementById('hp-pastebox');
    var pick = document.getElementById('hp-pick');
    var preview = document.getElementById('hp-paste-preview');
    var thumb = document.getElementById('hp-paste-thumb');
    var chip = document.getElementById('hp-paste-chip');
    var label = document.getElementById('hp-paste-label');
    var clear = document.getElementById('hp-paste-clear');
    var objectUrl = null;

    // Drawn pictures waiting to be saved: staged file name -> the drawing's JSON. The hidden
    // fields that carry them are rebuilt from input.files on every preview, never maintained on
    // their own, so clearing, re-picking files by hand or a bfcache restore cannot leave a
    // drawing's JSON attached to the wrong picture.
    var drawings = {};
    var sketchFields = document.getElementById('hp-sketch-fields');

    function syncSketchFields(staged) {
        if (!sketchFields) return 0;
        while (sketchFields.firstChild) sketchFields.removeChild(sketchFields.firstChild);
        var present = {};
        staged.forEach(function (f) {
            if (!Object.prototype.hasOwnProperty.call(drawings, f.name)) return;
            present[f.name] = true;
            var field = document.createElement('input');
            field.type = 'hidden';
            field.name = 'sketches';
            field.value = f.name + '|' + drawings[f.name];
            sketchFields.appendChild(field);
        });
        Object.keys(drawings).forEach(function (n) { if (!present[n]) delete drawings[n]; });
        return Object.keys(present).length;
    }
    function plural(n, one, many) { return n + ' ' + (n === 1 ? one : many); }

    // Assigning to input.files works everywhere current but throws on older Safari. If it does,
    // leave the file picker exactly as it was and say nothing — the coach still has a way in.
    function canInject() {
        try { return typeof DataTransfer === 'function' && !!new DataTransfer(); }
        catch (e) { return false; }
    }

    function releaseUrl() {
        if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
    }

    function showPreview() {
        releaseUrl();

        var staged = input.files ? Array.prototype.slice.call(input.files) : [];
        var drawn = syncSketchFields(staged);
        updateDrawState();
        if (!staged.length) { hidePreview(); return; }

        // Preview the most recent one — a strip of thumbnails would crowd the form, and the count
        // beside it is what actually answers "did all four land?".
        var file = staged[staged.length - 1];
        var isImage = file.type && file.type.indexOf('image/') === 0;

        if (isImage) {
            objectUrl = URL.createObjectURL(file);
            thumb.src = objectUrl;
            thumb.hidden = false;
            chip.hidden = true;
        } else {
            // A PDF has nothing to show, so name it rather than render a broken image.
            chip.textContent = file.name || 'PDF';
            chip.hidden = false;
            thumb.hidden = true;
        }

        var base = preview.dataset.readyLabel || 'Ready to save';
        var pictures = staged.length - drawn;
        label.textContent = staged.length === 1
            ? base
            : drawn === 0
                ? staged.length + ' pictures ready to save'
                : [drawn ? plural(drawn, 'drawing', 'drawings') : null,
                   pictures ? plural(pictures, 'picture', 'pictures') : null]
                      .filter(Boolean).join(', ') + ' ready to save';
        preview.hidden = false;
    }

    function hidePreview() {
        syncSketchFields(input.files ? Array.prototype.slice.call(input.files) : []);
        updateDrawState();
        releaseUrl();
        preview.hidden = true;
        thumb.hidden = true;
        chip.hidden = true;
        thumb.removeAttribute('src');
    }

    // Adds to what's already staged rather than replacing it. A drill can hold several pictures,
    // so pasting a second screenshot has to build the set up — replacing would silently discard
    // the first and there'd be nothing on screen to say so.
    function accept(newFiles) {
        var incoming = (newFiles || []).filter(function (f) { return f; });
        if (!incoming.length || !canInject()) return false;

        try {
            var dt = new DataTransfer();
            var existing = input.files ? Array.prototype.slice.call(input.files) : [];
            existing.concat(incoming).forEach(function (f) { dt.items.add(f); });
            input.files = dt.files;
        } catch (e) {
            return false;   // leave whatever the picker already had alone
        }

        showPreview();
        return true;
    }

    // ── Paste ────────────────────────────────────────────────────────
    // Only acts on a paste that actually carries a file. Pasting text into the description has to
    // keep behaving normally, so there is no preventDefault unless a file is really there.
    document.addEventListener('paste', function (e) {
        var items = e.clipboardData && e.clipboardData.items;
        if (!items) return;

        var found = [];
        for (var i = 0; i < items.length; i++) {
            if (items[i].kind !== 'file') continue;
            var file = items[i].getAsFile();
            if (file) found.push(file);
        }
        if (found.length && accept(found)) e.preventDefault();
    });

    // ── Drag and drop ────────────────────────────────────────────────
    // Bound to the whole document, not just the form. Without preventDefault the browser opens a
    // dropped file as a page and the half-filled form is gone — and a near miss outside the form
    // is exactly when that would happen, so catching it only over the form would leave the
    // footgun loaded. Dragging an image onto this page has one obvious meaning; take it wherever
    // it lands.
    function hasFiles(e) {
        var types = e.dataTransfer && e.dataTransfer.types;
        // types is a plain array in current browsers and a DOMStringList in older ones; the
        // borrowed indexOf handles both.
        return !!types && Array.prototype.indexOf.call(types, 'Files') !== -1;
    }

    ['dragenter', 'dragover'].forEach(function (name) {
        document.addEventListener(name, function (e) {
            if (!hasFiles(e)) return;
            e.preventDefault();
            form.classList.add('hp-dropping');
        });
    });

    ['dragleave', 'dragend'].forEach(function (name) {
        document.addEventListener(name, function (e) {
            // Only when the pointer has actually left the window, not on the stream of leave
            // events fired while crossing elements inside it.
            if (name === 'dragleave' && e.relatedTarget) return;
            form.classList.remove('hp-dropping');
        });
    });

    document.addEventListener('drop', function (e) {
        if (!hasFiles(e)) return;
        e.preventDefault();
        form.classList.remove('hp-dropping');

        var files = e.dataTransfer.files;
        if (files && files.length) accept(Array.prototype.slice.call(files));
    });

    // Choosing a file by hand after pasting must win, and must be what the preview shows.
    input.addEventListener('change', showPreview);

    clear.addEventListener('click', function () {
        input.value = '';
        hidePreview();
    });

    // Only this button opens the file dialog. Clicking the box around it just arms it for a
    // paste — which is the whole point of separating the two.
    if (pick) {
        pick.addEventListener('click', function (e) {
            e.stopPropagation();   // don't also re-focus the box behind it
            input.click();
        });
    }

    if (pastebox) {
        // Focusing gives a visible "ready" state. Paste itself is still bound to the document,
        // so a coach who pastes without clicking here first is not punished for it — the box
        // makes the gesture discoverable rather than mandatory.
        pastebox.addEventListener('click', function () { pastebox.focus(); });

        // A focusable div isn't a button to a keyboard or screen reader unless Enter and Space
        // do something. Both open the picker, which is the only action available here.
        pastebox.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault();
            input.click();
        });
    }

    // ── Drawing ──────────────────────────────────────────────────────
    // The editor (wwwroot/js/drill-sketch.js) knows nothing about drills. Everything about where
    // a drawing goes lives here: a new one is staged into the file input like a pasted picture,
    // and an edited one is posted straight over the picture it was drawn as.
    var drawRow = document.getElementById('hp-draw-row');
    var drawBtn = document.getElementById('hp-draw');
    var drawNote = document.getElementById('hp-draw-note');
    var titleInput = document.getElementById('title');
    var runInput = document.getElementById('runTimeMinutes');
    // The value, not the attribute's presence: Razor renders data-* attributes even when the
    // value is null, so data-failed="" is on every page and hasAttribute was always true.
    var formFailed = form.getAttribute('data-failed') === '1';
    var draftKey = drawRow ? drawRow.dataset.draft : null;
    var editButtons = Array.prototype.slice.call(document.querySelectorAll('.hp-edit-drawing'));
    var copyButtons = Array.prototype.slice.call(document.querySelectorAll('.hp-copy-drawing'));
    var drawSeq = 0;
    var loadingEditor = null;

    function roomLeft() {
        return parseInt(drawRow.dataset.room, 10) - (input.files ? input.files.length : 0);
    }

    // On a new drill, a save that bounces (a missing run time, say) re-renders the form and the
    // browser drops every staged file. So Draw waits until the fields that can bounce it are
    // filled in. The editor's autosave is the second line of defence.
    function fieldsReady() {
        return titleInput.value.trim() !== '' && runInput.checkValidity();
    }

    // Draw is only switched off when the drill has no room. Missing fields are handled on press
    // instead (see drawPressed): disabling the button for them made it look working and do
    // nothing, because .hp-btn has no disabled style, and a coach reported Draw as broken.
    function updateDrawState() {
        if (!drawRow || drawRow.hidden) return;
        var room = roomLeft() > 0;
        drawBtn.disabled = !room;
        drawNote.textContent = !room ? 'This drill has no room for another picture.' : '';
        copyButtons.forEach(function (b) { b.disabled = !room; });
    }

    // Says which field is missing and takes the coach to it, with the browser's own bubble.
    function drawPressed() {
        if (!fieldsReady()) {
            var missing = titleInput.value.trim() === '' ? titleInput : runInput;
            drawNote.textContent = 'Fill in the drill name and run time first, so a drawing can\'t be lost if the save bounces.';
            missing.focus();
            if (missing.reportValidity) missing.reportValidity();
            return;
        }
        drawNote.textContent = '';
        openNew(null, 'Draw a diagram');
    }

    function loadEditor() {
        if (window.HPSketch) return Promise.resolve(window.HPSketch);
        if (loadingEditor) return loadingEditor;
        loadingEditor = new Promise(function (resolve, reject) {
            var script = document.createElement('script');
            script.src = drawRow.dataset.src;
            script.onload = function () { if (window.HPSketch) resolve(window.HPSketch); else reject(new Error()); };
            script.onerror = function () { loadingEditor = null; reject(new Error()); };
            document.head.appendChild(script);
        });
        return loadingEditor;
    }

    function editorFailed() {
        drawNote.textContent = 'The drawing tool didn\'t load. Check the connection and try again.';
    }

    // Other drawings on this drill, offered as a starting point. Reusing the player setup from
    // the previous stage is the common case.
    function starters() {
        var list = [];
        document.querySelectorAll('.hp-diagram-item[data-sketch]').forEach(function (item) {
            if (item.dataset.sketch) list.push({ label: 'Picture ' + item.dataset.position, sketch: item.dataset.sketch });
        });
        var n = 0;
        Object.keys(drawings).forEach(function (name) {
            list.push({ label: 'Unsaved drawing ' + (++n), sketch: drawings[name] });
        });
        return list;
    }

    function stageDrawing(png, json) {
        var name = 'sketch-' + Date.now().toString(36) + '-' + (++drawSeq) + '.png';
        drawings[name] = json;
        var ok = false;
        try { ok = accept([new File([png], name, { type: 'image/png' })]); } catch (e) { ok = false; }
        if (!ok) {
            delete drawings[name];
            throw new Error('This browser can\'t attach the drawing to the form. A current Chrome, Edge or Safari can.');
        }
    }

    function openNew(sketch, title) {
        loadEditor().then(function (editor) {
            return editor.open({
                title: title,
                sketch: sketch || null,
                starters: sketch ? [] : starters(),
                draft: { key: draftKey, keepOnUse: true, offerStaged: formFailed },
                onUse: function (result) { stageDrawing(result.png, result.json); }
            });
        }, editorFailed);
    }

    function openEdit(item) {
        var token = form.querySelector('input[name="__RequestVerificationToken"]');
        var next = null;
        loadEditor().then(function (editor) {
            return editor.open({
                title: 'Edit drawing',
                sketch: item.dataset.sketch,
                draft: { key: draftKey + ':' + item.dataset.diagramId, keepOnUse: false, offerStaged: false },
                onUse: function (result) {
                    var body = new FormData();
                    if (token) body.append('__RequestVerificationToken', token.value);
                    body.append('picture', result.png, 'drawing.png');
                    body.append('sketch', result.json);
                    return fetch(item.dataset.sketchUrl, {
                        method: 'POST', body: body, credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    }).then(function (res) {
                        return res.json().catch(function () { return { ok: false }; });
                    }, function () {
                        throw new Error('Not saved: no connection. Your drawing is still here, so try again.');
                    }).then(function (data) {
                        if (!data || !data.ok)
                            throw new Error((data && data.error) || 'Not saved. Your drawing is still here, so try again.');
                        next = data.url;
                    });
                }
            });
        }, editorFailed).then(function (used) {
            if (used && next) window.location.assign(next);
        });
    }

    if (drawRow && canInject()) {
        drawRow.hidden = false;
        copyButtons.forEach(function (b) { b.hidden = false; });

        drawBtn.addEventListener('click', drawPressed);
        titleInput.addEventListener('input', updateDrawState);
        runInput.addEventListener('input', updateDrawState);
        copyButtons.forEach(function (b) {
            b.addEventListener('click', function () {
                openNew(b.closest('.hp-diagram-item').dataset.sketch, 'Next stage');
            });
        });
        updateDrawState();
    }
    // Editing posts on its own and attaches nothing to the form, so it doesn't need DataTransfer.
    if (drawRow && window.fetch && window.FormData) {
        editButtons.forEach(function (b) {
            b.hidden = false;
            b.addEventListener('click', function () { openEdit(b.closest('.hp-diagram-item')); });
        });
    }

    // A drawing stays in storage after it is staged, until the drill is known to have saved.
    // Landing here without an error means the last save went through (or was never attempted),
    // so a staged copy is finished with. Landing here WITH an error means the browser just
    // dropped the staged file, and the copy in storage is the only one left.
    if (draftKey) {
        try {
            var kept = JSON.parse(localStorage.getItem(draftKey) || 'null');
            if (kept && kept.staged) {
                if (!formFailed) localStorage.removeItem(draftKey);
                else if (drawRow && !drawRow.hidden) {
                    var hint = document.createElement('div');
                    hint.className = 'hp-draw-note';
                    hint.style.width = '100%';
                    hint.textContent = 'Your drawing wasn\'t saved with the drill. Press Draw a diagram to get it back.';
                    drawRow.appendChild(hint);
                }
            }
        } catch (e) { /* storage unavailable: nothing to tidy or offer */ }
    }

    // Coming back via the Back button restores the page from the bfcache, but a file put into the
    // input by script does not reliably come back with it. Without this the preview would still be
    // sitting there promising a diagram that is no longer attached, and saving would quietly drop
    // it. Clear both so the form can't lie about what it's about to send.
    window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        input.value = '';
        hidePreview();
    });
})();
</script>
}
