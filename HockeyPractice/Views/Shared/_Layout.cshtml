@{
    var team = ViewBag.Team as Team;
    var title = ViewBag.Title as string ?? "EBHockey Plans";
    var primary = team?.SafePrimary ?? Team.DefaultPrimary;
    var accent  = team?.SafeAccent  ?? Team.DefaultAccent;
    var palette = HockeyPractice.Infrastructure.Palette.CssVariables(primary, accent);
}
<!DOCTYPE html>
@* Team colours ride on the root element so one stylesheet serves every team. *@
@* Text colours are derived from the team's own, not assumed: plenty of real hockey colours
   are light enough that white text on them is unreadable. *@
<html lang="en" style="@palette">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="@primary" />
    <title>@title</title>
    <link rel="stylesheet" href="~/css/hockeypractice.css" asp-append-version="true" />
    <link rel="manifest" href="@Url.Action("Manifest", "Home")" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
    @RenderBody()

    @* A quiet, always-reachable path to /admin. Safe to show unconditionally: the login
       there is code-gated server-side and reveals nothing by itself. Hiding this link
       entirely (as an earlier version did) meant the only way to reach it was already
       knowing the URL — which broke first-time setup, since the claim needed to make the
       link "visible" can only be obtained by visiting the page the link would have shown. *@
    <footer class="hp-footer">
        <a asp-controller="SiteAdmin" asp-action="Index">Site admin</a>
    </footer>
<script>
(function () {
    // Confirmations come from a data attribute, not inline onsubmit. Inline confirm() with an interpolated name
    // breaks on an apostrophe — "O'Brien" produced a JS parse error, and a handler that fails
    // to parse doesn't stop the form, so the delete ran with NO confirmation at all.
    document.addEventListener('submit', function (e) {
        var form = e.target;
        var msg = form.getAttribute && form.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) {
            e.preventDefault();
            return;
        }

        // One tap, one submit. A slow upload on rink wifi invites a second tap, and a second
        // tap meant a duplicate plan. Disable after the browser captures the form data (next
        // tick), so named submit buttons — the roster picker relies on them — still post.
        var buttons = form.querySelectorAll('button[type="submit"], input[type="submit"]');
        setTimeout(function () {
            buttons.forEach(function (b) {
                b.disabled = true;
                var busy = b.getAttribute('data-busy');
                if (busy) b.textContent = busy;
            });
        }, 0);
    });

    // Back/forward cache restores the page with buttons still disabled — re-enable.
    window.addEventListener('pageshow', function () {
        document.querySelectorAll('button[type="submit"][disabled], input[type="submit"][disabled]')
            .forEach(function (b) { b.disabled = false; });
    });

    // A <details> menu stays open until it's told otherwise; close it on an outside tap or
    // Escape so it behaves like a menu rather than a stuck panel.
    document.addEventListener('click', function (e) {
        document.querySelectorAll('details.hp-menu[open]').forEach(function (menu) {
            if (!menu.contains(e.target)) menu.open = false;
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('details.hp-menu[open]').forEach(function (menu) {
            menu.open = false;
        });
    });

    // ── Suggestions on a comma-separated tag field ──────────────────────
    // A <datalist> matches against the WHOLE value of its input, not the bit you're currently
    // typing. On a comma-separated field that means suggestions work for the first tag and then
    // stop dead: once the box reads "breakout, " nothing matches any option, so the second tag
    // gets free-typed and the vocabulary drifts — "backcheck" and "back check" as two tags.
    //
    // Fix: rebuild the options as "everything you've typed so far + candidate", so the browser's
    // own matching keeps working for every tag after the first. Picking one then appends a comma
    // so the next suggestion is one keystroke away rather than needing a comma typed first.
    document.querySelectorAll('input[data-taglist]').forEach(function (input) {
        var list = document.getElementById(input.getAttribute('data-taglist'));
        if (!list) return;

        var all = Array.prototype.slice.call(list.options).map(function (o) { return o.value; });
        if (!all.length) return;

        function refresh() {
            var value = input.value;
            var parts = value.split(',');

            // Everything before the last comma is settled; the last piece is being typed, so it
            // must stay suggestable — otherwise typing a tag in full hides the very option that
            // would complete it.
            var settled = parts.slice(0, -1).map(function (p) { return p.trim().toLowerCase(); });
            var cut = value.lastIndexOf(',');
            var prefix = cut === -1 ? '' : value.slice(0, cut + 1) + ' ';

            list.innerHTML = '';
            all.forEach(function (tag) {
                if (settled.indexOf(tag.toLowerCase()) !== -1) return;   // already in the box
                var option = document.createElement('option');
                option.value = prefix + tag;
                list.appendChild(option);
            });

            return prefix;
        }

        input.addEventListener('input', function (e) {
            var before = input.value;
            var prefix = refresh();

            // Only when the browser says this came from picking a suggestion. Matching on the
            // text alone looked equivalent and was not: typing a tag that merely STARTS with an
            // existing one got a comma injected mid-word, so reaching for "backchecking" past
            // an existing "backcheck" produced "backcheck, ing". Browsers that don't report
            // inputType simply don't get the shortcut, and a typed comma still works.
            if (e && e.inputType !== 'insertReplacementText') return;

            var picked = all.some(function (tag) { return before === prefix + tag; });
            if (picked) {
                input.value = before + ', ';
                refresh();
            }
        });

        input.addEventListener('focus', refresh);
        refresh();
    });
})();
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
