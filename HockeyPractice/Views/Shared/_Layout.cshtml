@inject HockeyPractice.Infrastructure.MaintenanceState Maintenance
@{
    var team = ViewBag.Team as Team;
    var title = ViewBag.Title as string ?? "EBHockey Plans";
    var primary = team?.SafePrimary ?? Team.DefaultPrimary;
    var accent  = team?.SafeAccent  ?? Team.DefaultAccent;
    var palette = HockeyPractice.Infrastructure.Palette.CssVariables(primary, accent);
}
<!DOCTYPE html>
@* Team colours ride on the root element so one stylesheet serves every team. *@
@* Text colours are derived from the team's own, not assumed: plenty of real hockey colours
   are light enough that white text on them is unreadable. *@
<html lang="en" style="@palette">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="@primary" />
    <title>@title</title>
    <link rel="stylesheet" href="~/css/hockeypractice.css" asp-append-version="true" />
    <link rel="manifest" href="@Url.Action("Manifest", "Home")" />

    @* The .ico carries 16, 32 and 48 with transparent corners, so the tab icon sits on whatever
       colour the browser's tab strip is rather than in a white box. apple-touch-icon is a
       separate opaque file because iOS masks and rounds it itself, and transparency there shows
       up as black slivers behind the rounding. Versioned, since a favicon is cached hard and a
       stale one would outlive several deploys. *@
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
</head>
<body>
    @* Everyone sees this, not just the admin who set it. A coach whose save is about to be
       refused should find out before typing out a plan, not after. Cheap to render: the state
       is a field in memory, never a query. *@
    @if (Maintenance.IsPaused)
    {
        <div class="hp-warn hp-warn-banner">
            The site is undergoing maintenance. Saving and editing are disabled.
            Reading plans works as usual.
        </div>
    }

    @RenderBody()

    @{
        var onHome =
            string.Equals(ViewContext.RouteData.Values["controller"] as string, "Home", StringComparison.OrdinalIgnoreCase) &&
            string.Equals(ViewContext.RouteData.Values["action"] as string, "Index", StringComparison.OrdinalIgnoreCase);
    }
    <footer class="hp-footer">
        <p class="hp-footer-feedback">
            Comments or feedback?
            <a href="mailto:bensoneh@outlook.com">Contact us</a>
        </p>
        <div class="hp-footer-links">
            @* On every page, so there is always a way back to the team list even from the code
               gate and the error page, neither of which has a team header. Hidden on the team
               list itself, where it would only link to the page you are already on. *@
            @if (!onHome)
            {
                <a asp-controller="Home" asp-action="Index">All teams</a>
            }
            <a class="hp-footer-badge"
               href="https://upturtle.com/?utm_source=ebhockeyplan&amp;utm_medium=page-button&amp;utm_campaign=construction-page&amp;utm_content=hosted-with-upturtle"
               target="_blank" rel="noopener">Hosted on UpTurtle</a>
        </div>
    </footer>
<script>
(function () {
    // Confirmations come from a data attribute, not inline onsubmit. Inline confirm() with an interpolated name
    // breaks on an apostrophe — "O'Brien" produced a JS parse error, and a handler that fails
    // to parse doesn't stop the form, so the delete ran with NO confirmation at all.
    document.addEventListener('submit', function (e) {
        var form = e.target;
        var msg = form.getAttribute && form.getAttribute('data-confirm');
        if (msg && !window.confirm(msg)) {
            e.preventDefault();
            return;
        }

        // One tap, one submit. A slow upload on rink wifi invites a second tap, and a second
        // tap meant a duplicate plan. Disable after the browser captures the form data (next
        // tick), so named submit buttons — the roster picker relies on them — still post.
        var buttons = form.querySelectorAll('button[type="submit"], input[type="submit"]');
        var labels = [];
        buttons.forEach(function (b) { labels.push(b.textContent); });
        setTimeout(function () {
            buttons.forEach(function (b) {
                b.disabled = true;
                var busy = b.getAttribute('data-busy');
                if (busy) b.textContent = busy;
            });
        }, 0);

        // A form whose reply is a file download leaves the page exactly where it was, so none of
        // the things that normally revive these buttons ever happen: no navigation, and no
        // pageshow either. Without this the button sits there dead reading "Preparing...",
        // which looks like the download failed when it actually succeeded.
        if (form.hasAttribute('data-download')) {
            setTimeout(function () {
                buttons.forEach(function (b, i) {
                    b.disabled = false;
                    b.textContent = labels[i];
                });
            }, 5000);
        }
    });

    // Back/forward cache restores the page with buttons still disabled — re-enable.
    window.addEventListener('pageshow', function () {
        document.querySelectorAll('button[type="submit"][disabled], input[type="submit"][disabled]')
            .forEach(function (b) { b.disabled = false; });
    });

    // A <details> menu stays open until it's told otherwise; close it on an outside tap or
    // Escape so it behaves like a menu rather than a stuck panel.
    document.addEventListener('click', function (e) {
        document.querySelectorAll('details.hp-menu[open]').forEach(function (menu) {
            if (!menu.contains(e.target)) menu.open = false;
        });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('details.hp-menu[open]').forEach(function (menu) {
            menu.open = false;
        });
    });

    // ── Tag chips ───────────────────────────────────────────────────────
    // Tags are added one at a time and shown as chips. The previous comma-separated box stopped
    // suggesting anything after the first tag, because a <datalist> matches the whole value of
    // its input rather than the piece being typed — and a single long string gets unreadable
    // once a team has built up a real vocabulary.
    document.querySelectorAll('input[data-tagentry]').forEach(function (entry) {
        var chips = document.getElementById(entry.getAttribute('data-tagentry'));
        if (!chips) return;

        var name = chips.getAttribute('data-name') || 'tags';
        var max = parseInt(chips.getAttribute('data-max'), 10) || 15;
        var list = entry.getAttribute('list') ? document.getElementById(entry.getAttribute('list')) : null;
        var known = list ? Array.prototype.slice.call(list.options).map(function (o) { return o.value; }) : [];

        function current() {
            return Array.prototype.slice.call(chips.querySelectorAll('input[type="hidden"]'))
                .map(function (i) { return i.value; });
        }

        function add(raw) {
            var value = (raw || '').trim();
            if (!value) return;

            // Snap to the spelling the team already uses. Typing "breakout" where "Breakout"
            // exists should join that tag, not start a near-duplicate beside it — which is the
            // whole reason for suggesting existing tags in the first place.
            var match = known.filter(function (k) { return k.toLowerCase() === value.toLowerCase(); })[0];
            if (match) value = match;

            var already = current().some(function (v) { return v.toLowerCase() === value.toLowerCase(); });
            if (already) { entry.value = ''; return; }

            if (current().length >= max) {
                entry.value = '';
                return;
            }

            var chip = document.createElement('span');
            chip.className = 'hp-tagchip';

            var hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = name;
            hidden.value = value;

            var text = document.createElement('span');
            text.className = 'hp-tagchip-text';
            text.textContent = value;

            var remove = document.createElement('button');
            remove.type = 'button';          // a bare button would submit the form
            remove.className = 'hp-tagchip-x';
            remove.setAttribute('data-tagremove', '');
            remove.setAttribute('aria-label', 'Remove tag ' + value);
            remove.innerHTML = '&times;';

            chip.appendChild(hidden);
            chip.appendChild(text);
            chip.appendChild(remove);
            chips.appendChild(chip);

            entry.value = '';
        }

        // Enter must add a tag, NOT submit the form — which is what it would do by default and
        // would save the drill half-tagged.
        entry.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            e.preventDefault();
            // A highlighted suggestion belongs to the suggestion script below, which commits it
            // on this same keypress. This handler is registered first and therefore runs first,
            // so adding the typed text here as well is how "split" ended up as a chip of its own
            // beside "Split Ice". aria-activedescendant is only set while a row is highlighted.
            if (entry.getAttribute('aria-activedescendant')) return;
            add(entry.value);
        });

        // Picking from the suggestion list commits straight away; there's nothing to add to a
        // chosen tag, so making the coach press Add as well is a keystroke for nothing.
        entry.addEventListener('input', function (e) {
            if (e && e.inputType === 'insertReplacementText') add(entry.value);
        });

        entry.addEventListener('blur', function () {
            // Pressing a suggestion blurs this input before the pick commits, because the panel
            // isn't focusable and the suggestion script deliberately doesn't preventDefault on
            // pointerdown (that would kill scrolling on iOS). Committing here as well added the
            // partial word as its own chip next to the tag that was actually clicked. The marker
            // is set on pointerdown and cleared on release, so it spans exactly that window.
            if (entry.hasAttribute('data-suggest-press')) return;
            add(entry.value);
        });

        var addButton = document.querySelector('[data-tagadd="' + entry.id + '"]');
        if (addButton) {
            addButton.addEventListener('click', function () {
                add(entry.value);
                entry.focus();
            });
        }

        chips.addEventListener('click', function (e) {
            var button = e.target.closest ? e.target.closest('[data-tagremove]') : null;
            if (!button) return;
            var chip = button.parentNode;
            if (chip && chip.parentNode) chip.parentNode.removeChild(chip);
        });
    });
})();
</script>
<script>
// ── Tag suggestions ─────────────────────────────────────────────────────
// Deliberately its own IIFE, wrapped in try/catch, and NOT part of the script above. That one
// holds the delete confirmations, and this file already carries the scar of what happens when a
// fault takes them out: a handler that fails to parse does not stop the form, so the delete runs
// with no confirmation at all. A tag list is not worth risking that.
//
// Replaces <datalist>, which mobile Safari renders unreliably or not at all: the suggestions
// simply never appear, with no error. The datalist stays in the DOM as the data source and as the
// no-script fallback, and the input keeps its name, so with this script absent the field behaves
// exactly as it did before.
(function () {
    try {
        var inputs = document.querySelectorAll('input[data-suggest]');
        if (!inputs.length) return;

        inputs.forEach(function (input) {
            var list = document.getElementById(input.getAttribute('data-suggest'));
            var panel = document.getElementById(input.getAttribute('data-suggest-panel'));
            if (!list || !panel) return;

            var options = Array.prototype.slice.call(list.options).map(function (o) { return o.value; });
            if (!options.length) return;

            // Only in the tag editor: tags already on this drill cannot be added twice, so
            // offering them is misleading.
            var chipsId = input.getAttribute('data-suggest-exclude');
            function taken() {
                var chips = chipsId ? document.getElementById(chipsId) : null;
                if (!chips) return [];
                return Array.prototype.slice.call(chips.querySelectorAll('input[type="hidden"]'))
                    .map(function (i) { return i.value.toLowerCase(); });
            }

            var open = false, active = -1, shown = [], justPicked = false;

            // Touch gesture state. A press on a row might be a tap or the start of a scroll, and
            // which it was is only known on release.
            var press = null;
            var TAP_SLOP = 10;   // px of movement still counted as a tap, not a drag

            // Ends the press and tells the chip script the input is no longer mid-pick. Every
            // path that clears `press` goes through here, or a stale marker would swallow a
            // later real blur and lose a typed tag.
            function endPress() {
                press = null;
                input.removeAttribute('data-suggest-press');
            }

            function close() {
                open = false; active = -1;
                panel.hidden = true;
                panel.innerHTML = '';
                input.setAttribute('aria-expanded', 'false');
                input.removeAttribute('aria-activedescendant');
            }

            function render() {
                var typed = input.value.trim().toLowerCase();
                var already = taken();
                shown = options.filter(function (o) {
                    var lower = o.toLowerCase();
                    if (already.indexOf(lower) !== -1) return false;
                    return !typed || lower.indexOf(typed) !== -1;
                });

                if (!shown.length) { close(); return; }

                panel.innerHTML = '';
                shown.forEach(function (value, i) {
                    var row = document.createElement('div');
                    row.className = 'hp-suggest-item' + (i === active ? ' active' : '');
                    row.id = panel.id + '-o' + i;
                    row.setAttribute('role', 'option');
                    row.setAttribute('aria-selected', i === active ? 'true' : 'false');
                    row.textContent = value;

                    // Deliberately NO preventDefault here, and deliberately not committing on
                    // pointerdown. Doing both is what made the list unscrollable on iOS:
                    // preventDefault cancels the browser's default touch handling, and scrolling
                    // is part of what it cancels, while picking on contact means the first touch
                    // commits whatever is under the finger. Decide on release instead.
                    row.addEventListener('pointerdown', function (e) {
                        press = { row: row, value: value, x: e.clientX, y: e.clientY, drag: false };
                        input.setAttribute('data-suggest-press', '');
                    });

                    row.addEventListener('pointerup', function () {
                        var p = press;
                        endPress();
                        if (!p || p.drag || p.row !== row) return;
                        pick(value);
                    });
                    panel.appendChild(row);
                });

                panel.hidden = false;
                open = true;
                input.setAttribute('aria-expanded', 'true');
                if (active >= 0) input.setAttribute('aria-activedescendant', panel.id + '-o' + active);
                else input.removeAttribute('aria-activedescendant');

                // The phone keyboard covers the lower half of the screen, so a panel that opens
                // below the fold is invisible even though it rendered.
                if (panel.scrollIntoView) panel.scrollIntoView({ block: 'nearest' });
            }

            function pick(value) {
                input.value = value;
                close();
                // The chip script already treats insertReplacementText as "a suggestion was
                // chosen" and turns it into a chip. Firing exactly that keeps one commit path
                // rather than reaching into its closure. Where there is no chip script, this is
                // simply an input event and the value stays in the box.
                var ev;
                try {
                    ev = new InputEvent('input', { inputType: 'insertReplacementText', bubbles: true });
                } catch (e) {
                    ev = document.createEvent('Event');
                    ev.initEvent('input', true, false);
                }
                // Guarded, because refocusing after a pick would fire focus and reopen the panel
                // on top of the choice just made. Whether focus() fires at all depends on whether
                // the element was already focused, so the flag makes the behaviour the same
                // either way rather than depending on that.
                justPicked = true;
                input.dispatchEvent(ev);
                if (document.activeElement !== input) input.focus();
                setTimeout(function () { justPicked = false; }, 0);
            }

            input.setAttribute('role', 'combobox');
            input.setAttribute('aria-expanded', 'false');
            input.setAttribute('aria-autocomplete', 'list');
            input.setAttribute('aria-controls', panel.id);
            panel.setAttribute('role', 'listbox');

            // Movement and cancellation are tracked on the panel rather than per row, because a
            // scroll that starts on one row ends on another and the row's own handlers would
            // never see it.
            panel.addEventListener('pointermove', function (e) {
                if (!press) return;
                if (Math.abs(e.clientX - press.x) > TAP_SLOP ||
                    Math.abs(e.clientY - press.y) > TAP_SLOP) {
                    press.drag = true;
                }
            });

            // iOS fires this the moment it takes the gesture over for scrolling, which makes it
            // the most reliable "this was not a tap" signal available.
            panel.addEventListener('pointercancel', function () { endPress(); });

            // Safety net. A drag that starts on a row and releases anywhere else never reaches the
            // row's own pointerup, so without this `press` would stay set and the blur guard above
            // would keep the panel open for good. Runs after the row handler, which has already
            // done its work by the time the event bubbles this far.
            window.addEventListener('pointerup', function () { endPress(); });
            window.addEventListener('pointercancel', function () { endPress(); });

            input.addEventListener('focus', function () {
                // Consumed here as well as cleared on a timer. Whether the refocus in pick()
                // fires a focus event depends on whether the input was already focused, so the
                // flag has to be cleared on both paths or it could linger and swallow a later
                // legitimate focus.
                if (justPicked) { justPicked = false; return; }
                active = -1;
                render();
            });

            input.addEventListener('input', function (e) {
                // Ignore the event pick() just dispatched, or choosing an option would reopen
                // the panel on top of itself.
                if (e && e.inputType === 'insertReplacementText') return;
                active = -1;
                render();
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { if (open) { e.preventDefault(); close(); } return; }
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    if (!open) { render(); return; }
                    e.preventDefault();
                    active += (e.key === 'ArrowDown' ? 1 : -1);
                    if (active < -1) active = shown.length - 1;
                    if (active >= shown.length) active = -1;
                    render();
                    return;
                }
                // Enter with nothing highlighted falls through untouched, so it still adds
                // whatever was typed the way it always did.
                if (e.key === 'Enter' && open && active >= 0) {
                    e.preventDefault();
                    pick(shown[active]);
                }
            });

            input.addEventListener('blur', function () {
                // Deferred, because pointerdown on an option fires before blur settles. Skipped
                // entirely while a finger is down on the panel: without preventDefault, touching
                // the list blurs the input, and closing here would pull the list out from under
                // the scroll that was just starting.
                setTimeout(function () {
                    if (press) return;
                    close();
                }, 120);
            });

            // Last, and only now that the replacement works. Removing it earlier and then
            // throwing would leave desktop worse than it started.
            input.removeAttribute('list');
        });
    } catch (e) {
        // Leave the datalist in place and say nothing: the field still works, just natively.
    }
})();
</script>
<script>
// ── Bottom tab bar and the on-screen keyboard ────────────────────────────
// Own IIFE and wrapped, same reasoning as the blocks below: navigation styling is not worth
// risking the delete confirmations over.
//
// The bar is `position: fixed`, which pins it to the layout viewport, and the on-screen keyboard
// does not shrink that. Focus a field in the plan editor and the bar stays where the bottom of
// the page was before the keyboard opened, which puts it across the middle of the screen and
// leaves it drifting on every scroll. Hiding it while a field has focus is also the safer
// behaviour: it is a navigation bar, and one mis-tap abandons a half-written plan.
//
// The class is added on every screen width; the stylesheet only acts on it below 700px, where
// the bar is fixed in the first place.
(function () {
    try {
        var tabs = document.querySelector('.hp-tabs');
        if (!tabs) return;

        // Everything that isn't one of these raises a keyboard or a picker, including
        // datetime-local, which the plan editor uses.
        var NO_KEYBOARD = {
            button: 1, submit: 1, reset: 1, checkbox: 1, radio: 1,
            file: 1, image: 1, color: 1, range: 1, hidden: 1
        };
        function typing(el) {
            if (!el || !el.tagName) return false;
            if (el.isContentEditable) return true;
            if (el.tagName === 'TEXTAREA' || el.tagName === 'SELECT') return true;
            return el.tagName === 'INPUT' && !NO_KEYBOARD[(el.type || 'text').toLowerCase()];
        }
        function away(on) { tabs.classList.toggle('hp-tabs-away', on); }

        document.addEventListener('focusin', function (e) { if (typing(e.target)) away(true); });
        document.addEventListener('focusout', function () { away(false); });

        // iOS lets you swipe the keyboard down without blurring the field, so focusout is not the
        // only way back and the bar would stay hidden with nothing on screen explaining why. The
        // visible viewport returning to its resting height means the keyboard has gone, whatever
        // the focus says. Only the height is read, never a position: no arithmetic that could
        // misplace the bar, just shown or hidden.
        var vv = window.visualViewport;
        if (!vv) return;
        var rest = vv.height;
        window.addEventListener('orientationchange', function () { rest = 0; });
        vv.addEventListener('resize', function () {
            if (vv.height > rest) rest = vv.height;
            if (vv.height >= rest - 60) away(false);
            else if (typing(document.activeElement)) away(true);
        });
    } catch (e) {
        // Leave the bar exactly as it was: fixed, and visible.
    }
})();
</script>
<script>
// ── Scroll wheel over a number field ─────────────────────────────────────
// Its own IIFE for the same reason as the block above: nothing here is worth risking the delete
// confirmations over.
//
// A focused <input type="number"> treats a wheel or two-finger trackpad scroll as increment /
// decrement. On a Mac that means typing a run time of 12, scrolling the page to reach Save, and
// saving 13 without ever seeing it change (reproduced: one wheel event took 12 to 13). Dropping
// focus rather than preventing the wheel keeps the page scrolling normally; the typed value is
// untouched and the arrows and keyboard still work.
(function () {
    try {
        document.addEventListener('wheel', function () {
            var el = document.activeElement;
            if (el && el.type === 'number') el.blur();
        }, { passive: true });
    } catch (e) {
        // An older browser without the options object: leave the field alone.
    }
})();
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
