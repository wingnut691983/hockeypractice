@using HockeyPractice.Services
@model DrillCard
@{
    // The shared *content* of a drill row — name, gist, what it carries, tags. Deliberately no
    // <li> and no buttons: the library, the plan picker and the plan's own list each need
    // different controls, so they wrap this in their own markup. Keeping just the description
    // here is what stops the three drifting apart.
    var snippet = Model.Drill.Description is { Length: > 0 } d
        ? (d.Length > 110 ? d[..110].TrimEnd() + "…" : d)
        : null;
}
<div class="grow" style="min-width:0;">
    <div style="font-weight:650;">@Model.Drill.Title</div>

    @if (snippet is not null)
    {
        @* The class is a styling hook, not a context flag: _DrillPeek hides this while a peek is
           open, because the body below repeats it in full. Still context-free, which is the rule
           that matters here. *@
        <div class="hp-drill-snippet hp-muted" style="font-size:.85rem;">@snippet</div>
    }

    @* The card's time, not the drill's. This partial renders library rows, picker rows AND the
       rows of a plan, and the only difference between them is what the card carries: a plan's
       cards hold the minutes that plan added, a library card holds none and falls back to the
       drill. Reaching past the card to the drill's own run time here would show one plan's
       teaching time against that drill everywhere it appears. *@
    <div class="hp-muted" style="font-size:.78rem;margin-top:.15rem;">
        @if (Model.EffectiveRunTimeMinutes is int mins)
        {
            <text>@HockeyPractice.Infrastructure.RunTime.Human(mins) · </text>
        }
        @if (Model.HasDiagram)
        {
            <text>@Model.DiagramCount picture@(Model.DiagramCount == 1 ? "" : "s") · @PlanStorageService.Human(Model.DiagramBytes)</text>
        }
        else
        {
            <text>No pictures</text>
        }
        @if (Model.HasVideo)
        {
            <text> · Video</text>
        }
    </div>

    @if (Model.Drill.Tags.Count > 0)
    {
        <div style="margin-top:.3rem;">
            @foreach (var tag in Model.Drill.Tags.OrderBy(t => t.Name))
            {
                <span class="hp-pill">@tag.Name</span>
            }
        </div>
    }
</div>
