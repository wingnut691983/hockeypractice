@model (string Token, string Email, string TeamName)
@{ ViewBag.Title = "Stop these emails?"; }
<div class="hp-rail"></div>
<div class="hp-shell" style="max-width:28rem;">
    <h1 class="hp-title">Stop these emails?</h1>
    <p class="hp-muted">
        @Model.Email will stop getting an email when a new @Model.TeamName practice plan is posted.
        You can still open the plans any time with your team code.
    </p>

    @* A POST, and the only thing on this page that acts. The GET that got you here deliberately
       changes nothing, because link scanners and mail prefetchers follow links in message bodies
       and used to unsubscribe people who never clicked. See SubscriptionController.Unsubscribe. *@
    <form method="post" asp-action="UnsubscribeConfirmed" asp-route-token="@Model.Token">
        <button type="submit" class="hp-btn hp-btn-danger">Yes, stop these emails</button>
    </form>

    <p class="hp-muted" style="font-size:.82rem;margin-top:1.2rem;">
        Didn't mean to open this? Close the page and nothing changes.
    </p>
</div>
