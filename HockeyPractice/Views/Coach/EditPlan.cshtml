@using HockeyPractice.Services
@using HockeyPractice.Infrastructure
@model PlanEditViewModel
@{
    // Three modes, not two: editing an existing plan, starting a new one, and duplicating one.
    // A duplicate is "new" in that no row exists yet, but it already has its content, so the page
    // must not ask for a file or promise an upload.
    var heading = Model.IsDuplicate ? "Duplicate plan" : Model.IsNew ? "New plan" : "Edit plan";
    ViewBag.Title = heading + " – " + Model.Ctx.Team.Name;
    ViewBag.Team = Model.Ctx.Team;
    var slug = Model.Ctx.Team.Slug;

    // Empty when there is no date, rather than a formatted default(DateTime) — the field is
    // required and an empty one is what makes the browser hold the coach on it.
    var date = Model.Plan?.PracticeDateLocal ?? Model.DefaultDate;
    var dateValue = date?.ToString("yyyy-MM-ddTHH:mm") ?? "";
}
@await Html.PartialAsync("_TeamHeader", Model.Ctx)

<div class="hp-shell">
    <h1 class="hp-title">@(Model.IsDuplicate ? "Duplicate plan" : Model.IsNew ? "New practice plan" : "Edit plan")</h1>

    @if (Model.IsDuplicate)
    {
        @* Everything this copies happens after the form is submitted, so without saying so the
           page looks like it is about to make an empty plan — the drills, the PDF and the video
           names are all on sections that only render once a plan exists. *@
        <p class="hp-muted" style="margin:.2rem 0 0;">
            @if (Model.IsDrillPlan)
            {
                <text>
                    The same drills, in the same order, come across from the plan you're copying.
                    This is a new draft: changing it, or deleting it, leaves that plan alone.
                </text>
            }
            else
            {
                <text>
                    The same PDF and its video names come across from the plan you're copying.
                    This is a new draft: changing it, or deleting it, leaves that plan alone.
                </text>
            }
        </p>
    }

    @if (Model.Notice is not null)
    {
        <div class="hp-notice">@Model.Notice</div>
    }
    @if (Model.Error is not null)
    {
        <div class="hp-error">@Model.Error</div>
    }

    <form method="post" enctype="multipart/form-data" class="hp-form" style="margin-top:1rem;"
          asp-action="@(Model.IsDuplicate ? "DuplicatePlan" : Model.IsNew ? "NewPlan" : "EditPlan")"
          asp-route-slug="@slug" asp-route-id="@(Model.Plan?.Id ?? Model.SourcePlanId)">
        @Html.AntiForgeryToken()

        <div class="hp-field">
            <label class="hp-label" for="title">Title</label>
            <input class="hp-input" id="title" name="title" required maxlength="140"
                   value="@(Model.Plan?.Title ?? Model.RetainedTitle)" placeholder="e.g. Small-area games + breakouts" />
        </div>

        <div class="hp-field">
            <label class="hp-label" for="practiceDate">Practice date and time</label>
            <input class="hp-input" type="datetime-local" id="practiceDate" name="practiceDate"
                   required value="@dateValue" />
        </div>

        <div class="hp-field">
            <label class="hp-label" for="location">Rink (optional)</label>
            <input class="hp-input" id="location" name="location" maxlength="120"
                   value="@(Model.Plan?.Location ?? Model.RetainedLocation)" />
        </div>

        <div class="hp-field">
            <label class="hp-label" for="coachNotes">A note for the players (optional)</label>
            <textarea class="hp-textarea" id="coachNotes" name="coachNotes"
                      maxlength="2000">@(Model.Plan?.CoachNotes ?? Model.RetainedNotes)</textarea>
        </div>

        @await Html.PartialAsync("_TagEditor", new TagEditorModel
        {
            Name = "tags",
            Id = "plantags",
            Label = "Tags (skills, drill names)",
            Placeholder = "Type a tag, or pick an existing one",
            Hint = "Used to find this plan again later.",
            Current = Model.TagsValue,
            Known = Model.AllTags,
            Max = HockeyPractice.Controllers.CoachController.MaxTags
        })

        @* Carries the choice made on the chooser page through a failed submit, so a validation
           error can't silently turn a drill plan into a PDF one. *@
        @if (Model.IsNew)
        {
            <input type="hidden" name="kind" value="@Model.Kind" />
        }

        @* Not on a duplicate: the PDF comes from the plan being copied. Left in, its `required`
           would block the form on a file the coach has no reason to pick. *@
        @if (Model.IsNew && !Model.IsDuplicate && !Model.IsDrillPlan)
        {
            <div class="hp-field">
                <label class="hp-label" for="file">Practice plan (PDF)</label>
                <input class="hp-input" type="file" id="file" name="file"
                       accept="application/pdf,.pdf" required />
                <span class="hp-muted">
                    PDF only. In Word use File → Save As and pick PDF; in Google Docs use
                    File → Download → PDF Document.
                </span>
            </div>

            <details class="hp-panel" style="margin:0;">
                <summary style="cursor:pointer;font-weight:700;font-size:.9rem;">
                    Getting the video names right
                </summary>
                <p class="hp-muted" style="margin:.6rem 0 .4rem;">
                    Video names are read out of the PDF itself. One habit does most of the work:
                </p>
                <p style="margin:0 0 .5rem;">
                    <strong>Put the drill name and the link on the same line.</strong>
                </p>
                <div class="hp-mono hp-muted"
                     style="font-size:.78rem;background:var(--hp-surface-2);padding:.5rem .6rem;border-radius:8px;">
                    2. Breakouts<br />
                    &nbsp;&nbsp;&nbsp;D-to-D reversal - https://youtu.be/aBcDeFgHiJk
                </div>
                <p class="hp-muted" style="margin:.5rem 0 0;">
                    That becomes a card reading <em>Breakouts › D-to-D reversal</em>. A URL alone
                    on its own line has nothing to be named after and falls back to
                    &ldquo;Video&nbsp;1&rdquo;. Avoid link shorteners, because they hide which site
                    the video is on, so it can&rsquo;t be played in place. You can rename anything
                    here after uploading.
                </p>
            </details>
        }

        @if (!Model.IsNew && Model.IsDrillPlan)
        {
            @* Drill management lives below, outside this form — see the note at the bottom. *@
        }
        else if (!Model.IsNew && Model.Links.Count > 0)
        {
            <div class="hp-section" style="margin-bottom:.4rem;">Links found in the plan</div>
            <p class="hp-muted" style="margin:0;">
                Names come from the plan itself: a hyperlink's text, or the line and section
                heading it sits under. Rename anything that reads badly, and turn off anything
                that isn't a drill video.
            </p>
            <div class="hp-panel">
                <ul class="hp-list hp-linklist">
                    @foreach (var link in Model.Links)
                    {
                        <li>
                            <input type="hidden" name="linkId" value="@link.Id" />

                            @* Positive framing, and a real label rather than a bare box: ticked
                               means the players see it. The old control was an unlabelled
                               checkbox whose meaning was inverted, explained by two notes that
                               contradicted each other. *@
                            <label class="hp-showtoggle">
                                <input type="checkbox" name="visibleLinkId" value="@link.Id"
                                       checked="@(!link.IsHidden)" />
                                <span>Show to players</span>
                            </label>

                            <div class="grow">
                                @if (!string.IsNullOrWhiteSpace(link.Section))
                                {
                                    <div class="hp-video-section" style="margin-top:0;margin-bottom:.2rem;">
                                        @link.Section
                                    </div>
                                }
                                <input class="hp-input" name="linkLabel" value="@link.Label" maxlength="140" />
                                <div class="hp-muted hp-mono"
                                     style="overflow-wrap:anywhere;font-size:.76rem;margin-top:.2rem;">
                                    @link.Url
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <div class="hp-panel" style="margin:0;">
                <p class="hp-muted" style="margin-top:0;">
                    Names are worked out when a plan is uploaded, so a plan uploaded a while ago
                    keeps its original names. Re-reading the PDF picks up any later improvements.
                    Anything you renamed or hid by hand is kept.
                </p>
                <button type="submit" class="hp-btn hp-btn-quiet"
                        formaction="@Url.Action("ReExtract", "Coach", new { slug, id = Model.Plan?.Id })"
                        formmethod="post">
                    Re-read video names from the PDF
                </button>
            </div>
        }
        else if (!Model.IsNew && !Model.IsDrillPlan)
        {
            <div class="hp-notice">
                No links were found in this PDF. If you expected videos here, check that the URLs
                are in the document as text or real hyperlinks.
            </div>
        }

        @* Four cases, not two. A new drill plan isn't uploading anything, and saving it drops
           you straight into the add-drills step — so the button says where it's taking you
           rather than describing a file transfer that isn't happening. A duplicate isn't
           uploading anything either, whichever kind it is.
           data-busy: the layout's submit guard swaps this in while the request runs, so a coach
           on slow rink wifi sees something is actually happening. *@
        @{
            var submitLabel = !Model.IsNew ? "Save changes"
                : Model.IsDuplicate ? "Create the copy"
                : Model.IsDrillPlan ? "Add drills" : "Upload plan";
            var submitBusy = !Model.IsNew ? "Saving…"
                : Model.IsDuplicate ? "Copying…"
                : Model.IsDrillPlan ? "Saving…" : "Uploading…";
        }
        <button type="submit" class="hp-btn hp-btn-block" data-busy="@submitBusy">
            @submitLabel
        </button>
    </form>

    @* ── Overview picture ────────────────────────────────────────────────────────────────
       Its own form, outside the plan-details form above, for the same nested-form reason set out
       below — and so the Remove button can sit beside it without a formaction trick. *@
    @if (!Model.IsNew && Model.IsDrillPlan && Model.Plan is not null)
    {
        <div class="hp-section">Overview picture</div>
        <div class="hp-panel">
            <p class="hp-muted" style="margin-top:0;font-size:.82rem;">
                One picture of how the whole practice is laid out, shown on the plan between the
                running order and the drills. Worth adding when stations run at the same time and
                the order alone doesn't say where anyone goes. Optional: without one, nothing
                shows.
            </p>

            @if (Model.Plan.HasOverview)
            {
                var overviewUrl = Url.Action("Overview", "Plan",
                    new { slug, id = Model.Plan.Id });

                <div class="hp-diagram-item" style="margin-bottom:.8rem;">
                    <a href="@overviewUrl" target="_blank" rel="noopener noreferrer">
                        <img class="hp-plan-overview" style="max-height:11rem;margin-top:0;"
                             src="@overviewUrl" alt="The overview picture on this plan" />
                    </a>
                    <div class="hp-muted" style="font-size:.75rem;">
                        @PlanStorageService.Human(Model.Plan.OverviewBytes)
                    </div>
                    <form method="post" asp-action="RemoveOverview" asp-route-slug="@slug"
                          asp-route-id="@Model.Plan.Id"
                          data-confirm="Remove the overview picture from this plan?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="hp-btn hp-btn-danger hp-btn-sm">Remove</button>
                    </form>
                </div>
            }

            <form method="post" enctype="multipart/form-data" id="hp-ov-form"
                  asp-action="SetOverview" asp-route-slug="@slug" asp-route-id="@Model.Plan.Id">
                @Html.AntiForgeryToken()

                @* Same split as the drill form: the box arms a paste, and only the button inside
                   it opens the file dialog. Clicking anywhere near a bare file input to aim a
                   paste throws the picker open instead, which is what this avoids. *@
                @* No role="button" and no tabindex, unlike the drill version: paste is bound to
                   the document, so the box never needed focus to work, and making it a fake
                   button around a real one meant Enter did something the click did not. The
                   button inside is the only control, and :focus-within lights the box when it
                   is reached. *@
                <div class="hp-pastebox" id="hp-ov-pastebox">
                    <span class="hp-pastebox-main">Click here, then paste a picture</span>
                    <span class="hp-pastebox-sub" id="hp-ov-hint">
                        Cmd/Ctrl + V, or drag one onto the page
                    </span>
                    <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-ov-pick">
                        Choose a file instead
                    </button>
                </div>

                <input type="file" id="hp-ov-file" name="overview" hidden accept="image/*" />

                <div class="hp-paste-preview" id="hp-ov-preview" hidden
                     data-ready-label="Ready to save">
                    <img id="hp-ov-thumb" alt="The picture about to be saved" hidden />
                    <div class="hp-paste-note">
                        <span id="hp-ov-label"></span>
                        @* type="button": a bare button in a form submits, so clearing the
                           picture would save it instead. *@
                        <button type="button" class="hp-btn hp-btn-quiet hp-btn-sm" id="hp-ov-clear">
                            Clear
                        </button>
                    </div>
                </div>

                @* A block <p>, not a <span>: this form is a plain block, so an inline hint left
                   the button sitting on the end of the last line of text instead of under it.
                   Same shape as the Replace the PDF panel below. *@
                <p class="hp-muted" style="font-size:.8rem;margin:.6rem 0 .8rem;">
                    A photo or screenshot works well, and gets shrunk automatically. Images only,
                    since it has to show on the plan itself.
                    @if (Model.Plan.HasOverview)
                    {
                        <text>Saving a new one replaces the picture above.</text>
                    }
                </p>

                <button type="submit" class="hp-btn hp-btn-sm" data-busy="Saving…">
                    @(Model.Plan.HasOverview ? "Replace the picture" : "Save the picture")
                </button>
            </form>
        </div>
    }

    @* ── Drills ──────────────────────────────────────────────────────────────────────────
       Everything below is OUTSIDE the form above, and has to stay that way. HTML doesn't allow
       nested forms: the parser throws the inner <form> away, so an Add or Remove button placed
       inside would submit the plan-details form instead and appear to do nothing. Replace /
       Publish / Delete already sit out here for the same reason. *@
    @if (!Model.IsNew && Model.IsDrillPlan && Model.Plan is not null)
    {
        var planId = Model.Plan.Id;
        var tagFilter = Model.ActiveDrillTag;
        var nameFilter = Model.ActiveDrillName;
        // Carried through every add, move and remove alongside the two filters, so acting on a
        // drill returns you to the page of the picker you were looking at.
        var pageFilter = Model.LibraryPager.Page;

        <div class="hp-section" id="hp-plan-drills">Drills in this plan</div>
        @if (Model.PlanDrills.Count == 0)
        {
            <div class="hp-empty">
                Nothing here yet.<br />
                <span class="hp-muted">Add drills from your library below, and they'll run in the order you set.</span>
            </div>
        }
        else
        {
            var total = RunTimeTotal.From(Model.PlanDrills);
            if (total.HasAnything)
            {
                <div class="hp-runtime-total">
                    <strong>@Model.PlanDrills.Count drill@(Model.PlanDrills.Count == 1 ? "" : "s")</strong>
                    @if (!string.IsNullOrEmpty(total.Label))
                    {
                        <text> · @total.Label</text>
                    }
                </div>
            }
        }
        @if (Model.PlanDrills.Count > 0)
        {
            <div class="hp-panel">
                <ul class="hp-list">
                    @for (var i = 0; i < Model.PlanDrills.Count; i++)
                    {
                        var card = Model.PlanDrills[i];
                        <li style="flex-wrap:wrap;align-items:flex-start;">
                            <span class="hp-jersey" style="margin-top:.1rem;">@(i + 1)</span>
                            @* The plan's own running order stays a plain row: it already carries
                               move, remove and the per-drill time control, and the coach chose
                               these drills. The picker below is where peeking earns its place. *@
                            @await Html.PartialAsync("_DrillRow", card)

                            @* One form, three buttons separated by formaction — the same trick the
                               "Re-read video names" button uses, and a third of the markup of three
                               separate forms. *@
                            <form method="post" class="hp-row" style="gap:.2rem;"
                                  asp-action="MoveDrill" asp-route-slug="@slug" asp-route-id="@planId"
                                  asp-route-planDrillId="@card.PlanDrillId" asp-route-drillTag="@tagFilter"
                                  asp-route-drillName="@nameFilter" asp-route-drillPage="@pageFilter">
                                @Html.AntiForgeryToken()
                                <button type="submit" name="direction" value="up"
                                        class="hp-btn hp-btn-quiet hp-btn-sm" title="Move up"
                                        @(i == 0 ? "disabled" : "")>&uarr;</button>
                                <button type="submit" name="direction" value="down"
                                        class="hp-btn hp-btn-quiet hp-btn-sm" title="Move down"
                                        @(i == Model.PlanDrills.Count - 1 ? "disabled" : "")>&darr;</button>
                                <button type="submit" class="hp-btn hp-btn-danger hp-btn-sm"
                                        formaction="@Url.Action("RemoveDrill", "Coach", new { slug, id = planId, planDrillId = card.PlanDrillId, drillTag = tagFilter, drillName = nameFilter, drillPage = pageFilter })">
                                    Remove
                                </button>
                            </form>

                            @* A sibling of the form above, never nested inside it: a form within a
                               form is not valid and the inner one silently never posts.

                               Closed by default. A dozen drills each showing an open number field
                               and two buttons turns the running order into a wall of form, and the
                               order is what a coach comes here to read. <details> costs no script
                               and works on a phone. *@
                            @{
                                @* The drill's own time, taken through the card rather than by
                                   reaching into the drill. This is the one screen that legitimately
                                   wants the "normally" half instead of the effective total, and
                                   going via the card is what keeps the rule in the README intact:
                                   no view reaches past a card for a drill's length, so the grep
                                   that checks it stays worth running. *@
                                var baseMins = card.BaseRunTimeMinutes;
                                var extra = card.ExtraRunTimeMinutes;

                                var timeSummary = (baseMins, extra) switch
                                {
                                    (int b, int e) => $"Runs {RunTime.Human(b + e)} here, normally {RunTime.Human(b)}",
                                    (int _, null) => "Add extra time for this drill, this plan only",
                                    (null, int e) => $"Set to {RunTime.Human(e)} for this drill, this plan only",
                                    _ => "Set a time for this drill, this plan only"
                                };
                            }
                            <details class="hp-plan-time">
                                <summary>@timeSummary</summary>
                                <form method="post" class="hp-plan-time-form"
                                      asp-action="SetDrillTime" asp-route-slug="@slug" asp-route-id="@planId"
                                      asp-route-planDrillId="@card.PlanDrillId" asp-route-drillTag="@tagFilter"
                                      asp-route-drillName="@nameFilter" asp-route-drillPage="@pageFilter">
                                    @Html.AntiForgeryToken()
                                    <div class="hp-field" style="margin:0;">
                                        @* The id has to be unique per row, or every label on the
                                           page focuses the first drill's box. *@
                                        <label class="hp-label" for="extra-@card.PlanDrillId">
                                            @(baseMins is null ? "Time for this practice (minutes)" : "Extra time for this practice (minutes)")
                                        </label>
                                        <input class="hp-input" type="number" id="extra-@card.PlanDrillId"
                                               name="extraMinutes" min="1" max="@RunTime.MaxMinutes" step="1"
                                               inputmode="numeric" value="@(extra?.ToString() ?? "")"
                                               placeholder="@(baseMins is null ? "e.g. 25" : "e.g. 10")" />
                                    </div>
                                    <button type="submit" class="hp-btn hp-btn-sm">Save</button>
                                    @if (card.HasExtraRunTime)
                                    {
                                        <button type="submit" name="clear" value="1"
                                                class="hp-btn hp-btn-quiet hp-btn-sm">Clear</button>
                                    }
                                </form>
                                <p class="hp-muted" style="font-size:.78rem;margin:.35rem 0 0;">
                                    @if (baseMins is int shown)
                                    {
                                        <text>
                                            Added to the drill's usual @RunTime.Human(shown), in this plan only.
                                            Use it when a drill needs teaching before it flows.
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            This drill has no run time in your library, so it counts as nothing
                                            in the total. What you set here counts in this plan only.
                                        </text>
                                    }
                                </p>
                            </details>
                        </li>
                    }
                </ul>
            </div>
        }

        @* Above the picker, not below it. Publishing is the end of building a plan, and with the
           whole library and its pager in between it was something you had to go hunting for. *@
        @await Html.PartialAsync("_PlanPublishing", Model)

        <div class="hp-section" id="hp-drill-picker">Add a drill</div>

        @await Html.PartialAsync("_SearchFilters", new SearchFiltersModel
        {
            Id = "pickersearch",
            Noun = "Drill",
            NameField = "drillName",
            TagField = "drillTag",
            ActiveName = nameFilter,
            ActiveTag = tagFilter,
            KnownTags = Model.AllDrillTags,
            // A search is a GET that reloads the whole page, and the picker is a long way down
            // it. Without this the results land off screen and you scroll back to what you just
            // asked for. The pager's links already come back here for the same reason.
            Anchor = "hp-drill-picker"
        })

        @if (Model.Library.Count == 0)
        {
            <div class="hp-empty">
                @if (!string.IsNullOrWhiteSpace(tagFilter) || !string.IsNullOrWhiteSpace(nameFilter))
                {
                    <text>Nothing matches those filters.</text>
                }
                else
                {
                    <text>
                        Your drill library is empty.<br />
                        <span class="hp-muted">Create a drill and it'll appear here, ready to add.</span>
                    </text>
                }
            </div>
        }
        else
        {
            <div class="hp-panel">
                <ul class="hp-list">
                    @foreach (var card in Model.Library)
                    {
                        <li style="flex-wrap:wrap;align-items:flex-start;">
                            @* Peeks here too: picking drills for a practice is exactly when you
                               need to see what one contains, and leaving the page to find out
                               means abandoning the plan you are part way through building. *@
                            @await Html.PartialAsync("_DrillPeek", card)

                            @* Drawn here rather than inside _DrillRow or _DrillPeek, both of which
                               render from several call sites and have to stay context-free — a
                               check like "is this a plan row" in the partial is the bug waiting to
                               happen (see the README).

                               It says "In this plan", not "Added" and not a checkmark, and the Add
                               button beside it is deliberately unchanged. A drill legitimately runs
                               twice in one practice — warm-up and cool-down — so the marker has to
                               report state without reading as a door that has closed. A coach who
                               believes a second add is forbidden never tries it, which is the
                               misreading this exists to remove. *@
                            @if (Model.DrillIdsInPlan.Contains(card.Drill.Id))
                            {
                                <span class="hp-pill">In this plan</span>
                            }

                            <form method="post" asp-action="AddDrill" asp-route-slug="@slug"
                                  asp-route-id="@planId" asp-route-drillTag="@tagFilter"
                                  asp-route-drillName="@nameFilter" asp-route-drillPage="@pageFilter">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="drillId" value="@card.Drill.Id" />
                                <button type="submit" class="hp-btn hp-btn-sm">Add</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>

            @await Html.PartialAsync("_Pager", Model.LibraryPager)
        }

        @* Carries the way back, so building a plan isn't interrupted by remembering a missing
           drill halfway through. *@
        <div class="hp-panel" style="margin-top:.6rem;">
            <a class="hp-btn hp-btn-quiet" asp-controller="Drill" asp-action="New"
               asp-route-slug="@slug"
               asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)">
                + New drill
            </a>
            <span class="hp-muted" style="font-size:.8rem;margin-left:.5rem;">
                Comes straight back here when you've saved it.
            </span>
        </div>
    }

    @if (!Model.IsNew && Model.Plan is not null)
    {
        var plan = Model.Plan;

        @if (!Model.IsDrillPlan)
        {
            <div class="hp-section">Replace the PDF</div>
            <div class="hp-panel">
                <p class="hp-muted" style="margin-top:0;">
                    Swap in a corrected file. The link players already have keeps working, and
                    who's already read it isn't reset. Links are re-read from the new PDF, and
                    anything you've renamed or hidden here is kept where the same link is still
                    in the new file.
                </p>
                <form method="post" enctype="multipart/form-data" class="hp-row"
                      asp-action="ReplaceFile" asp-route-slug="@slug" asp-route-id="@plan.Id">
                    @Html.AntiForgeryToken()
                    <input class="hp-input" type="file" name="file" accept="application/pdf,.pdf"
                           required style="flex:1;min-width:12rem;" />
                    <button type="submit" class="hp-btn hp-btn-quiet" data-busy="Replacing…">Replace</button>
                </form>
            </div>
        }

        @* A drill plan has already shown this, above its picker. *@
        @if (!Model.IsDrillPlan)
        {
            @await Html.PartialAsync("_PlanPublishing", Model)
        }

        <div class="hp-panel">
            @if (!Model.IsDrillPlan)
            {
                <div class="hp-muted" style="margin-bottom:.5rem;">
                    @plan.OriginalFileName · @PlanStorageService.Human(plan.ByteSize)
                </div>
            }
            @* Not "and its PDF": a duplicate of this plan may be holding the same file, and the
               PDF only actually goes when nothing is left pointing at it. *@
            <form method="post" asp-action="DeletePlan" asp-route-slug="@slug" asp-route-id="@plan.Id"
                  data-confirm="@(Model.IsDrillPlan
                      ? "Delete this plan? The drills in it stay in your library. This cannot be undone."
                      : "Delete this plan? This cannot be undone.")">
                @Html.AntiForgeryToken()
                <button type="submit" class="hp-btn hp-btn-danger">Delete plan</button>
            </form>
            @if (Model.IsDrillPlan)
            {
                <div class="hp-muted" style="font-size:.78rem;margin-top:.3rem;">
                    Only the plan goes. Every drill stays in your library.
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
// Overview picture: paste, drag or pick. Ported from the drill diagram form, with one behavioural
// change — a plan holds ONE picture, so a second paste replaces the first rather than adding to
// it. Every id is namespaced hp-ov-*: the drill version owns the unprefixed ones, and if both
// ever render on one page getElementById would silently bind to whichever came first.
(function () {
    var input = document.getElementById('hp-ov-file');
    var form = document.getElementById('hp-ov-form');
    if (!input || !form) return;

    var pick = document.getElementById('hp-ov-pick');
    var preview = document.getElementById('hp-ov-preview');
    var thumb = document.getElementById('hp-ov-thumb');
    var label = document.getElementById('hp-ov-label');
    var clear = document.getElementById('hp-ov-clear');
    var objectUrl = null;

    // Assigning to input.files works everywhere current but throws on older Safari. If it does,
    // leave the file picker exactly as it was and say nothing — the button still works.
    function canInject() {
        try { return typeof DataTransfer === 'function' && !!new DataTransfer(); }
        catch (e) { return false; }
    }

    function releaseUrl() {
        if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
    }

    function hidePreview() {
        releaseUrl();
        preview.hidden = true;
        thumb.hidden = true;
        thumb.removeAttribute('src');
    }

    function showPreview() {
        releaseUrl();

        var staged = input.files ? Array.prototype.slice.call(input.files) : [];
        if (!staged.length) { hidePreview(); return; }

        objectUrl = URL.createObjectURL(staged[0]);
        thumb.src = objectUrl;
        thumb.hidden = false;
        label.textContent = preview.dataset.readyLabel || 'Ready to save';
        preview.hidden = false;
    }

    // REPLACES what is staged. A plan has one overview, so the newest picture wins — appending
    // the way the drill form does would stage several and silently save only the first.
    function accept(newFiles) {
        var incoming = (newFiles || []).filter(function (f) {
            return f && f.type && f.type.indexOf('image/') === 0;
        });
        if (!incoming.length || !canInject()) return false;

        try {
            var dt = new DataTransfer();
            dt.items.add(incoming[0]);
            input.files = dt.files;
        } catch (e) {
            return false;   // leave whatever the picker already had alone
        }

        showPreview();
        return true;
    }

    // Only acts on a paste carrying an image file. Pasting text into the title, the notes or a
    // tag field has to keep behaving normally, so there is no preventDefault unless a file is
    // really there.
    document.addEventListener('paste', function (e) {
        var items = e.clipboardData && e.clipboardData.items;
        if (!items) return;

        var found = [];
        for (var i = 0; i < items.length; i++) {
            if (items[i].kind !== 'file') continue;
            var file = items[i].getAsFile();
            if (file) found.push(file);
        }
        if (found.length && accept(found)) e.preventDefault();
    });

    function hasFiles(e) {
        var types = e.dataTransfer && e.dataTransfer.types;
        // A plain array in current browsers, a DOMStringList in older ones; the borrowed
        // indexOf handles both.
        return !!types && Array.prototype.indexOf.call(types, 'Files') !== -1;
    }

    // Bound to the document, not the form. Without preventDefault the browser opens a dropped
    // file as a page and the half-filled editor is gone — and a near miss outside the form is
    // exactly when that happens, so guarding only the form would leave the footgun loaded.
    ['dragenter', 'dragover'].forEach(function (name) {
        document.addEventListener(name, function (e) {
            if (!hasFiles(e)) return;
            e.preventDefault();
            form.classList.add('hp-dropping');
        });
    });

    ['dragleave', 'dragend'].forEach(function (name) {
        document.addEventListener(name, function (e) {
            // Only once the pointer has actually left the window, not on the stream of leave
            // events fired while crossing elements inside it.
            if (name === 'dragleave' && e.relatedTarget) return;
            form.classList.remove('hp-dropping');
        });
    });

    document.addEventListener('drop', function (e) {
        if (!hasFiles(e)) return;
        e.preventDefault();
        form.classList.remove('hp-dropping');

        var files = e.dataTransfer.files;
        if (files && files.length) accept(Array.prototype.slice.call(files));
    });

    input.addEventListener('change', showPreview);

    clear.addEventListener('click', function () {
        input.value = '';
        hidePreview();
    });

    if (pick) {
        pick.addEventListener('click', function () { input.click(); });
    }

    // Coming back via the Back button restores the page from the bfcache, but a file put into the
    // input by script does not reliably come back with it. Without this the preview would sit
    // there promising a picture that is no longer attached, and saving would quietly drop it.
    window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        input.value = '';
        hidePreview();
    });
})();

(function () {
    var copy = document.getElementById('hp-copy');
    if (!copy) return;

    copy.addEventListener('click', function () {
        var url = copy.dataset.url;
        var done = function () {
            var original = copy.textContent;
            copy.textContent = 'Copied ✓';
            setTimeout(function () { copy.textContent = original; }, 1800);
        };

        // Native share sheet on a phone goes straight into the group chat; clipboard on desktop.
        if (navigator.share) {
            navigator.share({ url: url }).then(done).catch(function () { /* dismissed */ });
        } else if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(done).catch(function () { window.prompt('Copy this link:', url); });
        } else {
            window.prompt('Copy this link:', url);
        }
    });
})();
</script>
}
