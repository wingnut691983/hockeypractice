@using HockeyPractice.Services
@model PlanEditViewModel
@{
    ViewBag.Title = (Model.IsNew ? "New plan" : "Edit plan") + " – " + Model.Ctx.Team.Name;
    ViewBag.Team = Model.Ctx.Team;
    var slug = Model.Ctx.Team.Slug;
    var dateValue = (Model.Plan?.PracticeDateLocal ?? Model.DefaultDate).ToString("yyyy-MM-ddTHH:mm");
}
@await Html.PartialAsync("_TeamHeader", Model.Ctx)

<div class="hp-shell">
    <h1 class="hp-title">@(Model.IsNew ? "New practice plan" : "Edit plan")</h1>

    @if (Model.Notice is not null)
    {
        <div class="hp-notice">@Model.Notice</div>
    }
    @if (Model.Error is not null)
    {
        <div class="hp-error">@Model.Error</div>
    }

    <form method="post" enctype="multipart/form-data" class="hp-form" style="margin-top:1rem;"
          asp-action="@(Model.IsNew ? "NewPlan" : "EditPlan")"
          asp-route-slug="@slug" asp-route-id="@Model.Plan?.Id">
        @Html.AntiForgeryToken()

        <div class="hp-field">
            <label class="hp-label" for="title">Title</label>
            <input class="hp-input" id="title" name="title" required maxlength="140"
                   value="@(Model.Plan?.Title ?? Model.RetainedTitle)" placeholder="e.g. Small-area games + breakouts" />
        </div>

        <div class="hp-field">
            <label class="hp-label" for="practiceDate">Practice date and time</label>
            <input class="hp-input" type="datetime-local" id="practiceDate" name="practiceDate"
                   required value="@dateValue" />
        </div>

        <div class="hp-field">
            <label class="hp-label" for="location">Rink (optional)</label>
            <input class="hp-input" id="location" name="location" maxlength="120"
                   value="@(Model.Plan?.Location ?? Model.RetainedLocation)" />
        </div>

        <div class="hp-field">
            <label class="hp-label" for="coachNotes">A note for the players (optional)</label>
            <textarea class="hp-textarea" id="coachNotes" name="coachNotes"
                      maxlength="2000">@(Model.Plan?.CoachNotes ?? Model.RetainedNotes)</textarea>
        </div>

        @await Html.PartialAsync("_TagEditor", new TagEditorModel
        {
            Name = "tags",
            Id = "plantags",
            Label = "Tags (skills, drill names)",
            Placeholder = "Type a tag, or pick an existing one",
            Hint = "Used to find this plan again later.",
            Current = Model.TagsValue,
            Known = Model.AllTags,
            Max = HockeyPractice.Controllers.CoachController.MaxTags
        })

        @* Carries the choice made on the chooser page through a failed submit, so a validation
           error can't silently turn a drill plan into a PDF one. *@
        @if (Model.IsNew)
        {
            <input type="hidden" name="kind" value="@Model.Kind" />
        }

        @if (Model.IsNew && !Model.IsDrillPlan)
        {
            <div class="hp-field">
                <label class="hp-label" for="file">Practice plan (PDF)</label>
                <input class="hp-input" type="file" id="file" name="file"
                       accept="application/pdf,.pdf" required />
                <span class="hp-muted">
                    PDF only. In Word use File → Save As and pick PDF; in Google Docs use
                    File → Download → PDF Document.
                </span>
            </div>

            <details class="hp-panel" style="margin:0;">
                <summary style="cursor:pointer;font-weight:700;font-size:.9rem;">
                    Getting the video names right
                </summary>
                <p class="hp-muted" style="margin:.6rem 0 .4rem;">
                    Video names are read out of the PDF itself. One habit does most of the work:
                </p>
                <p style="margin:0 0 .5rem;">
                    <strong>Put the drill name and the link on the same line.</strong>
                </p>
                <div class="hp-mono hp-muted"
                     style="font-size:.78rem;background:var(--hp-surface-2);padding:.5rem .6rem;border-radius:8px;">
                    2. Breakouts<br />
                    &nbsp;&nbsp;&nbsp;D-to-D reversal - https://youtu.be/aBcDeFgHiJk
                </div>
                <p class="hp-muted" style="margin:.5rem 0 0;">
                    That becomes a card reading <em>Breakouts › D-to-D reversal</em>. A URL alone
                    on its own line has nothing to be named after and falls back to
                    &ldquo;Video&nbsp;1&rdquo;. Avoid link shorteners &mdash; they hide which site
                    the video is on, so it can&rsquo;t be played in place. You can rename anything
                    here after uploading.
                </p>
            </details>
        }

        @if (!Model.IsNew && Model.IsDrillPlan)
        {
            @* Drill management lives below, outside this form — see the note at the bottom. *@
        }
        else if (!Model.IsNew && Model.Links.Count > 0)
        {
            <div class="hp-section" style="margin-bottom:.4rem;">Links found in the plan</div>
            <p class="hp-muted" style="margin:0;">
                Names come from the plan itself — a hyperlink's text, or the line and section
                heading it sits under. Rename anything that reads badly, and turn off anything
                that isn't a drill video.
            </p>
            <div class="hp-panel">
                <ul class="hp-list hp-linklist">
                    @foreach (var link in Model.Links)
                    {
                        <li>
                            <input type="hidden" name="linkId" value="@link.Id" />

                            @* Positive framing, and a real label rather than a bare box: ticked
                               means the players see it. The old control was an unlabelled
                               checkbox whose meaning was inverted, explained by two notes that
                               contradicted each other. *@
                            <label class="hp-showtoggle">
                                <input type="checkbox" name="visibleLinkId" value="@link.Id"
                                       checked="@(!link.IsHidden)" />
                                <span>Show to players</span>
                            </label>

                            <div class="grow">
                                @if (!string.IsNullOrWhiteSpace(link.Section))
                                {
                                    <div class="hp-video-section" style="margin-top:0;margin-bottom:.2rem;">
                                        @link.Section
                                    </div>
                                }
                                <input class="hp-input" name="linkLabel" value="@link.Label" maxlength="140" />
                                <div class="hp-muted hp-mono"
                                     style="overflow-wrap:anywhere;font-size:.76rem;margin-top:.2rem;">
                                    @link.Url
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <div class="hp-panel" style="margin:0;">
                <p class="hp-muted" style="margin-top:0;">
                    Names are worked out when a plan is uploaded, so a plan uploaded a while ago
                    keeps its original names. Re-reading the PDF picks up any later improvements.
                    Anything you renamed or hid by hand is kept.
                </p>
                <button type="submit" class="hp-btn hp-btn-quiet"
                        formaction="@Url.Action("ReExtract", "Coach", new { slug, id = Model.Plan?.Id })"
                        formmethod="post">
                    Re-read video names from the PDF
                </button>
            </div>
        }
        else if (!Model.IsNew && !Model.IsDrillPlan)
        {
            <div class="hp-notice">
                No links were found in this PDF. If you expected videos here, check that the URLs
                are in the document as text or real hyperlinks.
            </div>
        }

        @* Three cases, not two. A new drill plan isn't uploading anything, and saving it drops
           you straight into the add-drills step — so the button says where it's taking you
           rather than describing a file transfer that isn't happening.
           data-busy: the layout's submit guard swaps this in while the request runs, so a coach
           on slow rink wifi sees something is actually happening. *@
        @{
            var submitLabel = !Model.IsNew ? "Save changes"
                : Model.IsDrillPlan ? "Add drills" : "Upload plan";
            var submitBusy = !Model.IsNew ? "Saving…"
                : Model.IsDrillPlan ? "Saving…" : "Uploading…";
        }
        <button type="submit" class="hp-btn hp-btn-block" data-busy="@submitBusy">
            @submitLabel
        </button>
    </form>

    @* ── Drills ──────────────────────────────────────────────────────────────────────────
       Everything below is OUTSIDE the form above, and has to stay that way. HTML doesn't allow
       nested forms: the parser throws the inner <form> away, so an Add or Remove button placed
       inside would submit the plan-details form instead and appear to do nothing. Replace /
       Publish / Delete already sit out here for the same reason. *@
    @if (!Model.IsNew && Model.IsDrillPlan && Model.Plan is not null)
    {
        var planId = Model.Plan.Id;
        var tagFilter = Model.ActiveDrillTag;
        var nameFilter = Model.ActiveDrillName;

        <div class="hp-section" id="hp-plan-drills">Drills in this plan</div>
        @if (Model.PlanDrills.Count == 0)
        {
            <div class="hp-empty">
                Nothing here yet.<br />
                <span class="hp-muted">Add drills from your library below — they'll run in the order you set.</span>
            </div>
        }
        else
        {
            var total = RunTimeTotal.From(Model.PlanDrills);
            if (total.HasAnything)
            {
                <div class="hp-runtime-total">
                    <strong>@Model.PlanDrills.Count drill@(Model.PlanDrills.Count == 1 ? "" : "s")</strong>
                    @if (!string.IsNullOrEmpty(total.Label))
                    {
                        <text> · @total.Label</text>
                    }
                </div>
            }
        }
        @if (Model.PlanDrills.Count > 0)
        {
            <div class="hp-panel">
                <ul class="hp-list">
                    @for (var i = 0; i < Model.PlanDrills.Count; i++)
                    {
                        var card = Model.PlanDrills[i];
                        <li style="flex-wrap:wrap;align-items:flex-start;">
                            <span class="hp-jersey" style="margin-top:.1rem;">@(i + 1)</span>
                            @await Html.PartialAsync("_DrillRow", card)

                            @* One form, three buttons separated by formaction — the same trick the
                               "Re-read video names" button uses, and a third of the markup of three
                               separate forms. *@
                            <form method="post" class="hp-row" style="gap:.2rem;"
                                  asp-action="MoveDrill" asp-route-slug="@slug" asp-route-id="@planId"
                                  asp-route-planDrillId="@card.PlanDrillId" asp-route-drillTag="@tagFilter"
                                  asp-route-drillName="@nameFilter">
                                @Html.AntiForgeryToken()
                                <button type="submit" name="direction" value="up"
                                        class="hp-btn hp-btn-quiet hp-btn-sm" title="Move up"
                                        @(i == 0 ? "disabled" : "")>&uarr;</button>
                                <button type="submit" name="direction" value="down"
                                        class="hp-btn hp-btn-quiet hp-btn-sm" title="Move down"
                                        @(i == Model.PlanDrills.Count - 1 ? "disabled" : "")>&darr;</button>
                                <button type="submit" class="hp-btn hp-btn-danger hp-btn-sm"
                                        formaction="@Url.Action("RemoveDrill", "Coach", new { slug, id = planId, planDrillId = card.PlanDrillId, drillTag = tagFilter, drillName = nameFilter })">
                                    Remove
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="hp-section">Add a drill</div>

        @await Html.PartialAsync("_SearchFilters", new SearchFiltersModel
        {
            Id = "pickersearch",
            Noun = "Drill",
            NameField = "drillName",
            TagField = "drillTag",
            ActiveName = nameFilter,
            ActiveTag = tagFilter,
            KnownTags = Model.AllDrillTags
        })

        @if (Model.Library.Count == 0)
        {
            <div class="hp-empty">
                @if (!string.IsNullOrWhiteSpace(tagFilter) || !string.IsNullOrWhiteSpace(nameFilter))
                {
                    <text>Nothing matches those filters.</text>
                }
                else
                {
                    <text>
                        Your drill library is empty.<br />
                        <span class="hp-muted">Create a drill and it'll appear here, ready to add.</span>
                    </text>
                }
            </div>
        }
        else
        {
            <div class="hp-panel">
                <ul class="hp-list">
                    @foreach (var card in Model.Library)
                    {
                        <li style="flex-wrap:wrap;align-items:flex-start;">
                            @await Html.PartialAsync("_DrillRow", card)
                            <form method="post" asp-action="AddDrill" asp-route-slug="@slug"
                                  asp-route-id="@planId" asp-route-drillTag="@tagFilter"
                                  asp-route-drillName="@nameFilter">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="drillId" value="@card.Drill.Id" />
                                <button type="submit" class="hp-btn hp-btn-sm">Add</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }

        @* Carries the way back, so building a plan isn't interrupted by remembering a missing
           drill halfway through. *@
        <div class="hp-panel" style="margin-top:.6rem;">
            <a class="hp-btn hp-btn-quiet" asp-controller="Drill" asp-action="New"
               asp-route-slug="@slug"
               asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)">
                + New drill
            </a>
            <span class="hp-muted" style="font-size:.8rem;margin-left:.5rem;">
                Comes straight back here when you've saved it.
            </span>
        </div>
    }

    @if (!Model.IsNew && Model.Plan is not null)
    {
        var plan = Model.Plan;

        @if (!Model.IsDrillPlan)
        {
            <div class="hp-section">Replace the PDF</div>
            <div class="hp-panel">
                <p class="hp-muted" style="margin-top:0;">
                    Swap in a corrected file. The link players already have keeps working, and
                    who's already read it isn't reset. Links are re-read from the new PDF —
                    anything you've renamed or hidden here is kept where the same link is still
                    in the new file.
                </p>
                <form method="post" enctype="multipart/form-data" class="hp-row"
                      asp-action="ReplaceFile" asp-route-slug="@slug" asp-route-id="@plan.Id">
                    @Html.AntiForgeryToken()
                    <input class="hp-input" type="file" name="file" accept="application/pdf,.pdf"
                           required style="flex:1;min-width:12rem;" />
                    <button type="submit" class="hp-btn hp-btn-quiet" data-busy="Replacing…">Replace</button>
                </form>
            </div>
        }

        <div class="hp-section">Publishing</div>
        <div class="hp-panel">
            @if (plan.Status == PlanStatus.Draft)
            {
                <p style="margin-top:0;">
                    This is a <strong>draft</strong> — players can't see it and no email has been sent.
                </p>
                <form method="post" asp-action="Publish" asp-route-slug="@slug" asp-route-id="@plan.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="hp-btn hp-btn-accent">Publish to the team</button>
                </form>
            }
            else
            {
                <p style="margin-top:0;">
                    Published@(plan.PublishedUtc is null ? "" : $" {plan.PublishedUtc:MMM d}"). Players can see this.
                </p>
                <div class="hp-row">
                    <button type="button" class="hp-btn" id="hp-copy"
                            data-url="@Url.Action("Details", "Plan", new { slug, id = plan.Id }, Context.Request.Scheme)">
                        Copy link for the team chat
                    </button>
                    <form method="post" asp-action="Unpublish" asp-route-slug="@slug" asp-route-id="@plan.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="hp-btn hp-btn-quiet">Unpublish</button>
                    </form>
                </div>
            }
        </div>

        <div class="hp-panel">
            @if (!Model.IsDrillPlan)
            {
                <div class="hp-muted" style="margin-bottom:.5rem;">
                    @plan.OriginalFileName · @PlanStorageService.Human(plan.ByteSize)
                </div>
            }
            <form method="post" asp-action="DeletePlan" asp-route-slug="@slug" asp-route-id="@plan.Id"
                  data-confirm="@(Model.IsDrillPlan
                      ? "Delete this plan? The drills in it stay in your library. This cannot be undone."
                      : "Delete this plan and its PDF? This cannot be undone.")">
                @Html.AntiForgeryToken()
                <button type="submit" class="hp-btn hp-btn-danger">Delete plan</button>
            </form>
            @if (Model.IsDrillPlan)
            {
                <div class="hp-muted" style="font-size:.78rem;margin-top:.3rem;">
                    Only the plan goes — every drill stays in your library.
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    var copy = document.getElementById('hp-copy');
    if (!copy) return;

    copy.addEventListener('click', function () {
        var url = copy.dataset.url;
        var done = function () {
            var original = copy.textContent;
            copy.textContent = 'Copied ✓';
            setTimeout(function () { copy.textContent = original; }, 1800);
        };

        // Native share sheet on a phone goes straight into the group chat; clipboard on desktop.
        if (navigator.share) {
            navigator.share({ url: url }).then(done).catch(function () { /* dismissed */ });
        } else if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(done).catch(function () { window.prompt('Copy this link:', url); });
        } else {
            window.prompt('Copy this link:', url);
        }
    });
})();
</script>
}
