@using HockeyPractice.Services
@model ManageViewModel
@{
    ViewBag.Title = "Manage – " + Model.Ctx.Team.Name;
    ViewBag.Team = Model.Ctx.Team;
    var slug = Model.Ctx.Team.Slug;
}
@await Html.PartialAsync("_TeamHeader", Model.Ctx)

<div class="hp-shell">
    <h1 class="hp-title">Manage</h1>

    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="hp-notice">@Model.Notice</div>
    }

    <a class="hp-btn hp-btn-accent hp-btn-block" style="margin:1rem 0;"
       asp-action="ChoosePlanKind" asp-route-slug="@slug">+ New practice plan</a>

    <div class="hp-section">Plans</div>

    <form method="get" asp-action="Index" asp-route-slug="@slug" class="hp-row" style="margin:.6rem 0;">
        <input class="hp-input" type="text" name="tag" value="@Model.ActiveTag"
               placeholder="Search tags (e.g. backcheck)" style="flex:1;" />
        <button type="submit" class="hp-btn hp-btn-sm">Search</button>
    </form>
    @if (Model.AllTags.Count > 0)
    {
        <div class="hp-row" style="flex-wrap:wrap;gap:.4rem;margin-bottom:.6rem;">
            @foreach (var t in Model.AllTags)
            {
                <a class="hp-pill @(string.Equals(Model.ActiveTag, t, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   asp-action="Index" asp-route-slug="@slug" asp-route-tag="@t">@t</a>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActiveTag))
    {
        <div class="hp-muted" style="margin-bottom:.6rem;">
            Showing plans tagged &ldquo;@Model.ActiveTag&rdquo; ·
            <a asp-action="Index" asp-route-slug="@slug">Clear</a>
        </div>
    }

    @if (Model.Plans.Count == 0)
    {
        <div class="hp-empty">No plans yet.</div>
    }
    else
    {
        <div class="hp-panel">
            <ul class="hp-list">
                @foreach (var card in Model.Plans)
                {
                    <li style="flex-wrap:wrap;">
                        <div class="grow">
                            <div style="font-weight:650;">@card.Plan.Title</div>
                            <div class="hp-muted">
                                @card.WhenLabel ·
                                @if (card.IsDrillPlan)
                                {
                                    <text>@card.DrillCount drill@(card.DrillCount == 1 ? "" : "s")</text>
                                }
                                else
                                {
                                    <text>@card.VideoCount video@(card.VideoCount == 1 ? "" : "s")</text>
                                }
                            </div>
                            @if (card.Plan.Tags.Count > 0)
                            {
                                <div style="margin-top:.3rem;">
                                    @foreach (var t in card.Plan.Tags.OrderBy(x => x.Name))
                                    {
                                        <a class="hp-pill" asp-action="Index" asp-route-slug="@slug"
                                           asp-route-tag="@t.Name">@t.Name</a>
                                    }
                                </div>
                            }
                        </div>
                        @if (card.IsDraft)
                        {
                            <span class="hp-pill hp-pill-draft">Draft</span>
                        }
                        <a class="hp-btn hp-btn-quiet hp-btn-sm"
                           asp-action="EditPlan" asp-route-slug="@slug" asp-route-id="@card.Plan.Id">Edit</a>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="hp-section">Roster</div>
    <div class="hp-panel">
        @if (Model.Roster.Count == 0)
        {
            <p class="hp-muted" style="margin-top:0;">
                Add your players so they can tap their name and you can see who's read each plan.
            </p>
        }
        else
        {
            <ul class="hp-list">
                @foreach (var player in Model.Roster)
                {
                    <li>
                        <span class="hp-jersey">@(string.IsNullOrEmpty(player.JerseyNumber) ? "–" : player.JerseyNumber)</span>
                        <span class="grow">@player.Name</span>
                        <form method="post" asp-action="DeletePlayer" asp-route-slug="@slug"
                              asp-route-playerId="@player.Id"
                              data-confirm="Remove @player.Name from the roster? This also deletes their view history.">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="hp-btn hp-btn-danger hp-btn-sm">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        }

        <form method="post" asp-action="AddPlayer" asp-route-slug="@slug"
              class="hp-row" style="margin-top:.8rem;">
            @Html.AntiForgeryToken()
            <input class="hp-input" name="name" placeholder="Player name" required style="flex:2;min-width:10rem;" />
            <input class="hp-input" name="jerseyNumber" placeholder="#" maxlength="4"
                   inputmode="numeric" style="flex:0 0 4.5rem;" />
            <button type="submit" class="hp-btn">Add</button>
        </form>
    </div>

    <div class="hp-section">Invite the team</div>
    <div class="hp-panel">
        @if (Model.Ctx.Team.ViewCode is { } viewCode)
        {
            var joinUrl = Url.Action("Index", "Team", new { slug, c = viewCode }, Context.Request.Scheme);
            <p class="hp-muted" style="margin-top:0;">
                Send this link to players and parents — one tap and they're in. Or they can type
                the code on the team page.
            </p>
            <div class="hp-row" style="align-items:center;gap:.8rem;">
                <span class="hp-code-display">@viewCode</span>
                <button type="button" class="hp-btn" id="hp-share-invite"
                        data-url="@joinUrl"
                        data-text="Practice plans for @Model.Ctx.Team.Name — tap to join:">
                    Share invite link
                </button>
            </div>
        }
        else
        {
            <p class="hp-muted" style="margin-top:0;">
                This team's code was created before shareable links existed, so it can't be shown
                here. Rotate it once and the new code will stay visible for sharing.
            </p>
        }
        <form method="post" asp-action="RotateCode" asp-route-slug="@slug" style="margin-top:.8rem;"
              data-confirm="Rotate the team code? Everyone will have to enter the new one.">
            @Html.AntiForgeryToken()
            <button type="submit" class="hp-btn hp-btn-quiet hp-btn-sm">Rotate team code</button>
        </form>
        <p class="hp-muted" style="font-size:.8rem;margin-bottom:0;">
            If a player leaves the team, rotate — they keep access until you do.
        </p>
    </div>

    <div class="hp-section">Branding</div>
    <div class="hp-panel">
        <form method="post" asp-action="Branding" asp-route-slug="@slug"
              enctype="multipart/form-data" class="hp-form">
            @Html.AntiForgeryToken()
            <div class="hp-field">
                <label class="hp-label" for="name">Team name</label>
                <input class="hp-input" id="name" name="name" value="@Model.Ctx.Team.Name" />
            </div>
            <div class="hp-row">
                <div class="hp-field" style="flex:1;">
                    <label class="hp-label" for="primaryColor">Primary</label>
                    <input class="hp-input" type="color" id="primaryColor" name="primaryColor"
                           value="@Model.Ctx.Team.PrimaryColor" style="min-height:44px;padding:.2rem;" />
                </div>
                <div class="hp-field" style="flex:1;">
                    <label class="hp-label" for="accentColor">Accent</label>
                    <input class="hp-input" type="color" id="accentColor" name="accentColor"
                           value="@Model.Ctx.Team.AccentColor" style="min-height:44px;padding:.2rem;" />
                </div>
            </div>
            <div class="hp-field">
                <label class="hp-label" for="timeZoneId">Time zone</label>
                <input class="hp-input" id="timeZoneId" name="timeZoneId"
                       value="@Model.Ctx.Team.TimeZoneId" placeholder="America/Chicago" />
            </div>
            <div class="hp-field">
                <label class="hp-label" for="logo">Logo (JPEG, PNG, GIF or WebP, under 2 MB)</label>
                <input class="hp-input" type="file" id="logo" name="logo" accept="image/*" />
            </div>
            <button type="submit" class="hp-btn">Save</button>
        </form>
    </div>

    <div class="hp-section">Locker-room playlist</div>
    <div class="hp-panel">
        <form method="post" asp-action="Playlist" asp-route-slug="@slug" class="hp-form">
            @Html.AntiForgeryToken()
            <div class="hp-field">
                <label class="hp-label" for="spotifyPlaylistUrl">Spotify playlist link</label>
                <input class="hp-input" id="spotifyPlaylistUrl" name="spotifyPlaylistUrl"
                       value="@Model.Ctx.Team.SpotifyPlaylistUrl"
                       placeholder="https://open.spotify.com/playlist/..." inputmode="url" />
            </div>
            <p class="hp-muted" style="font-size:.8rem;margin:0;">
                Must be an open.spotify.com playlist link. In Spotify, set the playlist to
                <strong>Collaborative</strong> (playlist menu &rarr; &ldquo;Make collaborative&rdquo;)
                so players can actually add songs &mdash; this site only shows the link, it can't
                grant that permission itself. Leave blank and save to remove it.
            </p>
            <button type="submit" class="hp-btn">Save</button>
        </form>
    </div>

    <div class="hp-section">Storage</div>
    <div class="hp-panel">
        <div class="hp-meter">
            <div class="hp-meter-fill @(Model.StorageTight ? "tight" : "")"
                 style="width:@(((int)(Model.UsedFraction * 100)).ToString())%;"></div>
        </div>
        <div class="hp-muted">
            @PlanStorageService.Human(Model.UsedBytes) of @PlanStorageService.Human(Model.QuotaBytes) used
            @if (Model.StorageTight)
            {
                <text>— delete some old plans soon.</text>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('hp-share-invite');
    if (!btn) return;
    btn.addEventListener('click', function () {
        var url = btn.dataset.url;
        var done = function () {
            var t = btn.textContent;
            btn.textContent = 'Copied ✓';
            setTimeout(function () { btn.textContent = t; }, 1800);
        };
        if (navigator.share) {
            navigator.share({ text: btn.dataset.text, url: url }).catch(function () { /* dismissed */ });
        } else if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(done).catch(function () { window.prompt('Copy this link:', url); });
        } else {
            window.prompt('Copy this link:', url);
        }
    });
})();
</script>
}
