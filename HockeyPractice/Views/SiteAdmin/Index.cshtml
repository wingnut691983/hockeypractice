@using HockeyPractice.Services
@model AdminViewModel
@{ ViewBag.Title = "Site admin"; }
<div class="hp-rail"></div>
<div class="hp-shell">
    <div class="hp-row" style="margin-top:1rem;justify-content:space-between;">
        <a class="hp-btn hp-btn-quiet hp-btn-sm" asp-controller="Home" asp-action="Index">← Back to the site</a>
        <form method="post" asp-action="Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="hp-btn hp-btn-quiet hp-btn-sm">Sign out of admin</button>
        </form>
    </div>
    <h1 class="hp-title">Site admin</h1>
    <p class="hp-muted" style="margin-top:-.25rem;">
        Create and remove teams, and issue their access codes. Running a team is the manager's
        job, so you don't hold that access by default — use <strong>Manage</strong> to take it
        when you need it. The team's pages will say you're in as site admin while you are.
    </p>

    @if (Model.Notice is not null)
    {
        <div class="hp-notice">@Model.Notice</div>
    }
    @if (Model.Error is not null)
    {
        <div class="hp-error">@Model.Error</div>
    }

    <div class="hp-section">Teams</div>
    @if (Model.Teams.Count == 0)
    {
        <div class="hp-empty">No teams yet. Create the first one below.</div>
    }
    else
    {
        <div class="hp-panel">
            <ul class="hp-list">
                @for (var i = 0; i < Model.Teams.Count; i++)
                {
                    var summary = Model.Teams[i];
                    <li style="flex-wrap:wrap;">
                        <div class="hp-row" style="gap:.2rem;">
                            <form method="post" asp-action="MoveTeam" asp-route-teamId="@summary.Team.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="direction" value="up" />
                                <button type="submit" class="hp-btn hp-btn-quiet hp-btn-sm" title="Move up"
                                        @(i == 0 ? "disabled" : "")>&uarr;</button>
                            </form>
                            <form method="post" asp-action="MoveTeam" asp-route-teamId="@summary.Team.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="direction" value="down" />
                                <button type="submit" class="hp-btn hp-btn-quiet hp-btn-sm" title="Move down"
                                        @(i == Model.Teams.Count - 1 ? "disabled" : "")>&darr;</button>
                            </form>
                        </div>
                        <div class="grow">
                            <div style="font-weight:650;">@summary.Team.Name</div>
                            <div class="hp-muted hp-mono">/t/@summary.Team.Slug</div>
                            <div class="hp-muted">@summary.PlanCount plans · @summary.PlayerCount players</div>
                        </div>
                        <form method="post" asp-action="EnterTeam" asp-route-teamId="@summary.Team.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="hp-btn hp-btn-quiet hp-btn-sm"
                                    title="Take manager access to this team">Manage</button>
                        </form>

                        <details style="flex-basis:100%;margin-top:.4rem;">
                            <summary class="hp-muted" style="cursor:pointer;font-size:.82rem;">Access codes</summary>
                            @if (summary.Team.ViewCode is { } vc)
                            {
                                <p class="hp-muted" style="font-size:.82rem;margin:.5rem 0;">
                                    Team code (players and parents): <span class="hp-mono"><strong>@vc</strong></span>.
                                    The manager code can't be read back — issue a new one to recover it.
                                </p>
                            }
                            else
                            {
                                <p class="hp-muted" style="font-size:.82rem;margin:.5rem 0;">
                                    Codes for this team can't be read back — issue a new one to
                                    recover access. New codes stay visible here.
                                </p>
                            }
                            <div class="hp-row">
                                <form method="post" asp-action="RegenerateCodes" asp-route-teamId="@summary.Team.Id"
                                      data-confirm="Issue a new TEAM code? Every player and parent will have to enter it again.">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="which" value="player" />
                                    <button type="submit" class="hp-btn hp-btn-quiet hp-btn-sm">New team code</button>
                                </form>
                                <form method="post" asp-action="RegenerateCodes" asp-route-teamId="@summary.Team.Id"
                                      data-confirm="Issue a new MANAGER code? Anyone using the old one loses manage access.">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="which" value="manager" />
                                    <button type="submit" class="hp-btn hp-btn-quiet hp-btn-sm">New manager code</button>
                                </form>
                            </div>
                        </details>

                        <details style="flex-basis:100%;margin-top:.4rem;">
                            <summary class="hp-muted" style="cursor:pointer;font-size:.82rem;">Delete team</summary>
                            <form method="post" asp-action="DeleteTeam" asp-route-teamId="@summary.Team.Id"
                                  class="hp-row" style="margin-top:.5rem;">
                                @Html.AntiForgeryToken()
                                <input class="hp-input" name="confirmName" required
                                       placeholder="Type &quot;@summary.Team.Name&quot; to confirm"
                                       style="flex:1;min-width:12rem;" />
                                <button type="submit" class="hp-btn hp-btn-danger hp-btn-sm">
                                    Delete permanently
                                </button>
                            </form>
                            <div class="hp-muted" style="font-size:.78rem;margin-top:.3rem;">
                                Removes @summary.PlanCount plan@(summary.PlanCount == 1 ? "" : "s"),
                                the roster, all view history, and every uploaded PDF. Cannot be undone.
                            </div>
                        </details>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="hp-section">New team</div>
    <div class="hp-panel">
        <form method="post" asp-action="CreateTeam" class="hp-form">
            @Html.AntiForgeryToken()
            <div class="hp-field">
                <label class="hp-label" for="name">Team name</label>
                <input class="hp-input" id="name" name="name" required maxlength="100" />
            </div>
            <div class="hp-field">
                <label class="hp-label" for="slug">URL slug (optional)</label>
                <input class="hp-input" id="slug" name="slug" maxlength="60" placeholder="derived from the name" />
            </div>
            <div class="hp-field">
                <label class="hp-label" for="timeZoneId">Time zone</label>
                <input class="hp-input" id="timeZoneId" name="timeZoneId" value="America/Chicago" />
            </div>
            <button type="submit" class="hp-btn">Create team</button>
            <span class="hp-muted">
                The team code and coach code are shown once, right after creation. Only their hashes are stored.
            </span>
        </form>
    </div>

    <div class="hp-section">Backup</div>
    <div class="hp-panel">
        <p class="hp-muted" style="margin-top:0;">
            The download is the whole site in one file: every team, plan, drill, roster and view
            history, plus the codes. Treat it like the codes themselves. It does
            <strong>not</strong> include uploaded PDFs or drill pictures, which are files on the
            volume rather than rows in the database.
        </p>

        @if (Model.WritesPaused)
        {
            <div class="hp-warn">
                <strong>Saving is paused for everyone.</strong>
                It switches back on by itself in
                @Model.PauseMinutesLeft minute@(Model.PauseMinutesLeft == 1 ? "" : "s"),
                or press Resume saving. Reading plans still works.
            </div>
        }

        <div class="hp-row" style="margin-top:.6rem;">
            @if (Model.WritesPaused)
            {
                <form method="post" asp-action="Maintenance">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="action" value="resume" />
                    <button type="submit" class="hp-btn">Resume saving</button>
                </form>
                <form method="post" asp-action="Maintenance">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="action" value="pause" />
                    <button type="submit" class="hp-btn hp-btn-quiet">Give it another 30 minutes</button>
                </form>
            }
            else
            {
                <form method="post" asp-action="Maintenance"
                      data-confirm="Pause saving for everyone? Coaches will not be able to save anything until you resume or 30 minutes pass.">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="action" value="pause" />
                    <button type="submit" class="hp-btn hp-btn-quiet">Pause saving (30 min)</button>
                </form>
            }

            @* data-download: the reply is a file, so the page never navigates and the shared
               submit-disabling in the layout would leave this button dead. *@
            <form method="post" asp-action="DownloadBackup" data-download>
                @Html.AntiForgeryToken()
                <button type="submit" class="hp-btn" data-busy="Preparing…">
                    Download database
                </button>
            </form>
        </div>

        <p class="hp-muted" style="font-size:.8rem;margin:.6rem 0 0;">
            The database is @PlanStorageService.Human(Model.DatabaseBytes). You do not have to
            pause to download: the copy is taken all at once, so it is consistent even if someone
            saves while it runs. Pausing is there for when you want the files on the volume to
            match it too, and it is required before restoring.
        </p>

        <details style="margin-top:.8rem;">
            <summary class="hp-muted" style="cursor:pointer;font-size:.82rem;">
                Restore from a backup file
            </summary>

            <div class="hp-warn" style="margin-top:.6rem;">
                <strong>This replaces everything.</strong> Every team, plan, drill and roster on
                the site is swapped for whatever is in the file, and anything added since that
                backup was taken is gone. The site restarts to load it, which takes about twenty
                seconds.
            </div>

            <form method="post" asp-action="RestoreBackup" enctype="multipart/form-data"
                  class="hp-form" style="margin-top:.6rem;"
                  data-confirm="Replace the live database with this file? Everything currently on the site is replaced.">
                @Html.AntiForgeryToken()
                <div class="hp-field">
                    <label class="hp-label" for="backup">Backup file</label>
                    <input class="hp-input" type="file" id="backup" name="backup" accept=".db" required />
                    <span class="hp-muted" style="font-size:.8rem;">
                        A file downloaded from this button, from this version of the site or an
                        older one. A backup from a newer version is refused.
                    </span>
                </div>
                <div class="hp-field">
                    <label class="hp-label" for="confirm">Type REPLACE to confirm</label>
                    <input class="hp-input" id="confirm" name="confirm" required autocomplete="off"
                           placeholder="REPLACE" style="max-width:14rem;" />
                </div>
                <button type="submit" class="hp-btn hp-btn-danger" data-busy="Restoring…">
                    Replace the database
                </button>
                @if (!Model.WritesPaused)
                {
                    <span class="hp-muted" style="font-size:.8rem;">
                        Pause saving first. Restoring while people are still writing would throw
                        away whatever they are in the middle of.
                    </span>
                }
            </form>

            @if (Model.ReplacedAtUtc is { } replacedAt)
            {
                <p class="hp-muted" style="font-size:.78rem;margin:.6rem 0 0;">
                    The last restore kept the database it replaced, holding everything up to
                    @replacedAt.ToString("d MMM yyyy HH:mm") UTC
                    (@PlanStorageService.Human(Model.ReplacedBytes)), at
                    <span class="hp-mono">@Model.ReplacedPath</span>. That is the way back from
                    restoring the wrong file, but only one is kept: the next restore overwrites it.
                </p>
            }
        </details>
    </div>

    <div class="hp-section">Storage</div>
    <div class="hp-panel hp-muted">
        @PlanStorageService.Human(Model.UsedBytes) of @PlanStorageService.Human(Model.QuotaBytes) used
    </div>
</div>
